@model MedicalERP.Domain.DTOs.CategoryDto

@{
    ViewData["Title"] = "Category Details";
}

<h2>Category Details</h2>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Code</dt>
            <dd class="col-sm-9">@Model.Code</dd>

            <dt class="col-sm-3">Parent Category</dt>
            <dd class="col-sm-9">
                @(Model.ParentCategoryName ?? "None")
            </dd>

            <dt class="col-sm-3">Display Order</dt>
            <dd class="col-sm-9">@Model.DisplayOrder</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                @(Model.IsActive ? "Active" : "Inactive")
            </dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-primary">
        Edit
    </a>

    <a asp-action="Index" class="btn btn-secondary">Back</a>
</div>