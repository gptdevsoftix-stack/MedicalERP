@model MedicalERP.Application.Sales.Dtos.SaleFormDto
@using System.Text.Json
@{ var products = (IEnumerable<MedicalERP.Application.Sales.Dtos.SaleProductLookupDto>)ViewBag.Products; }
<div asp-validation-summary="ModelOnly" class="text-danger mb-3" id="sale-error-summary"></div>
<div class="card mb-3">
    <div class="card-header"><h5 class="mb-0">Sale Details</h5></div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4"><label asp-for="CustomerId" class="form-label">Customer</label><select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select"><option value="">Walk-in customer</option></select></div>
            <div class="col-md-4"><label asp-for="InvoiceNumber" class="form-label"><span class="text-danger">*</span> Invoice Number</label><input asp-for="InvoiceNumber" class="form-control" data-required placeholder="e.g. INV-20260807-001" /><span asp-validation-for="InvoiceNumber" class="text-danger"></span></div>
            <div class="col-md-4"><label asp-for="SaleDate" class="form-label"><span class="text-danger">*</span> Sale Date</label><input asp-for="SaleDate" type="datetime-local" class="form-control" data-required /><span asp-validation-for="SaleDate" class="text-danger"></span></div>
            <div class="col-md-4"><label asp-for="WarehouseId" class="form-label">Warehouse</label><select asp-for="WarehouseId" asp-items="ViewBag.Warehouses" class="form-select"><option value="">No warehouse assigned</option></select></div>
            <div class="col-md-4"><label asp-for="RegisterSessionId" class="form-label">Register Session</label><select asp-for="RegisterSessionId" asp-items="ViewBag.RegisterSessions" class="form-select"><option value="">Auto-open on save</option></select><small class="text-muted d-block">An open register session is used for this sale.</small></div>
            <div class="col-12"><label asp-for="Notes" class="form-label">Notes</label><textarea asp-for="Notes" class="form-control" rows="2" placeholder="Optional internal notes"></textarea></div>
        </div>
    </div>
</div>
<div class="card mb-3">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h5 class="mb-0">Sale Lines</h5>
        <div class="d-flex gap-2 align-items-center">
            <input type="search" id="product-filter" class="form-control form-control-sm" style="min-width:220px" placeholder="Filter products..." />
            <button type="button" id="add-line" class="btn btn-sm btn-outline-primary"><i class="ti ti-plus me-1"></i>Add line</button>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th style="min-width:240px">Product</th><th style="min-width:150px">Unit</th><th style="min-width:90px">Qty</th><th style="min-width:110px">Unit Price</th><th style="min-width:110px">Discount</th><th style="min-width:110px">Tax</th><th class="text-end" style="min-width:90px">Total</th><th></th></tr></thead>
            <tbody id="sale-lines"></tbody>
        </table>
    </div>
    <div class="card-footer">
        <div class="row justify-content-end">
            <div class="col-md-5 col-lg-4">
                <div class="d-flex justify-content-between py-1"><span class="text-muted">Subtotal</span><strong id="sale-subtotal">0.00</strong></div>
                <div class="d-flex justify-content-between py-1"><span class="text-muted">Discount</span><strong id="sale-discount">0.00</strong></div>
                <div class="d-flex justify-content-between py-1"><span class="text-muted">Tax</span><strong id="sale-tax">0.00</strong></div>
                <hr class="my-1" />
                <div class="d-flex justify-content-between"><span class="fw-semibold">Grand total</span><strong id="sale-total" class="fs-5">0.00</strong></div>
            </div>
        </div>
    </div>
</div>
<div class="card">
    <div class="card-header"><h5 class="mb-0">Payment</h5></div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4"><label asp-for="PaymentMethodId" class="form-label">Payment Method</label><select asp-for="PaymentMethodId" asp-items="ViewBag.PaymentMethods" class="form-select"><option value="">No payment now</option></select></div>
            <div class="col-md-4"><label asp-for="PaidAmount" class="form-label">Amount Paid</label><div class="input-group"><span class="input-group-text">$</span><input asp-for="PaidAmount" type="number" min="0" step="0.01" class="form-control" id="PaidAmount" /></div></div>
            <div class="col-md-4"><label asp-for="PaymentReference" class="form-label">Reference</label><input asp-for="PaymentReference" class="form-control" placeholder="e.g. receipt or transfer ref" /></div>
        </div>
        <div class="row justify-content-end mt-3">
            <div class="col-md-5 col-lg-4">
                <div class="d-flex justify-content-between py-1"><span class="text-muted">Balance due</span><strong id="sale-due">0.00</strong></div>
                <div class="d-flex justify-content-between py-1"><span class="text-muted">Change</span><strong id="sale-change">0.00</strong></div>
            </div>
        </div>
    </div>
</div>
<div class="text-danger mt-2" id="sale-line-errors" style="display:none"></div>
<script id="product-data" type="application/json">@Html.Raw(JsonSerializer.Serialize(products))</script>
<script id="initial-items" type="application/json">@Html.Raw(JsonSerializer.Serialize(Model.Items))</script>
