<script>
(() => {
    const products = JSON.parse(document.getElementById('product-data').textContent || '[]').map(x => ({
        id: x.id ?? x.Id,
        name: x.name ?? x.Name,
        availableStock: x.availableStock ?? x.AvailableStock ?? 0,
        salePrice: x.salePrice ?? x.SalePrice ?? 0
    }));
    const initial = JSON.parse(document.getElementById('initial-items').textContent || '[]');
    const body = document.getElementById('sale-lines');
    const form = document.getElementById('sale-form');
    const filterBox = document.getElementById('product-filter');
    const lineErrors = document.getElementById('sale-line-errors');
    const paymentMethod = document.getElementById('PaymentMethodId');
    const otherPaymentWrap = document.getElementById('other-payment-method-wrap');
    const otherPaymentInput = document.getElementById('OtherPaymentMethodName');
    const grid = document.getElementById('product-grid');
    const gridEmpty = document.getElementById('product-grid-empty');
    const gridCount = document.getElementById('product-grid-count');
    const cartCount = document.getElementById('cart-count');
    const cart = document.getElementById('pos-cart');
    const cartClose = document.getElementById('pos-cart-close');
    const cartBackdrop = document.getElementById('pos-cart-backdrop');
    const mobileBar = document.getElementById('pos-mobile-bar');
    const mobileCount = document.getElementById('mobile-cart-count');
    const mobileTotal = document.getElementById('mobile-cart-total');
    const saveButton = form?.querySelector('[data-save-button]');
    const saveLabel = saveButton?.querySelector('[data-save-label]');
    const esc = value => String(value ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const cur = 'Rs';
    const money = value => (+value || 0).toFixed(2);
    const fmt = value => `${cur} ${money(value)}`;
    const fmtQty = value => (+value || 0).toLocaleString(undefined, { maximumFractionDigits: 4 });
    let submitted = false;
    let dirty = false;

    const productById = id => products.find(x => String(x.id) === String(id));

    const updateCartCount = () => {
        const count = [...body.children].filter(r => r.querySelector('[data-field="ProductId"]')?.value).length;
        if (cartCount) cartCount.textContent = `${count} item${count === 1 ? '' : 's'}`;
        if (mobileCount) mobileCount.textContent = `${count} item${count === 1 ? '' : 's'}`;
    };

    const openCart = () => {
        if (cart) cart.classList.add('open');
        if (cartBackdrop) cartBackdrop.classList.add('show');
    };

    const closeCart = () => {
        if (cart) cart.classList.remove('open');
        if (cartBackdrop) cartBackdrop.classList.remove('show');
    };

    const units = async (select, productId, selected) => {
        select.innerHTML = '<option value="">Loading...</option>';
        if (!productId) { select.innerHTML = '<option value="">Select unit</option>'; return; }
        try {
            const response = await fetch(`/Sales/ProductUnits?productId=${encodeURIComponent(productId)}`);
            if (!response.ok) throw new Error('Request failed');
            const data = await response.json();
            select.innerHTML = '<option value="">Select unit</option>' + data.map(x => `<option value="${x.id}" ${String(x.id) === String(selected) ? 'selected' : ''}>${esc(x.name)}</option>`).join('');
        } catch {
            select.innerHTML = '<option value="">Select unit</option><option value="" disabled>Failed to load units</option>';
        }
    };

    const setRowError = (row, message) => {
        let tip = row.querySelector('.sale-row-error');
        if (!tip) { tip = document.createElement('div'); tip.className = 'sale-row-error text-danger small mt-1'; row.querySelector('td').appendChild(tip); }
        tip.textContent = message;
        row.classList.add('sale-row-invalid');
    };

    const clearRowError = row => {
        const tip = row.querySelector('.sale-row-error');
        if (tip) tip.textContent = '';
        row.classList.remove('sale-row-invalid');
    };

    const refreshDuplicates = () => {
        const selected = new Set([...body.children].map(r => r.querySelector('[data-field="ProductId"]')?.value).filter(v => v));
        [...body.children].forEach(row => {
            const productInput = row.querySelector('[data-field="ProductId"]');
            if (!productInput || productInput.tagName !== 'SELECT') return;
            [...productInput.options].forEach(opt => {
                if (!opt.value) { opt.disabled = false; return; }
                opt.disabled = opt.value !== productInput.value && selected.has(opt.value);
            });
        });
    };

    const recalc = () => {
        let subtotal = 0;
        const lineCount = body.querySelectorAll('tr').length || 1;
        body.querySelectorAll('tr').forEach(row => {
            const qty = +row.querySelector('[data-field="Quantity"]')?.value || 0;
            const price = +row.querySelector('[data-field="UnitPrice"]')?.value || 0;
            const line = qty * price;
            row.querySelector('[data-total]').textContent = fmt(line);
            row.querySelector('[data-unit-price]').textContent = fmt(price);
            subtotal += line;
        });
        const discPct = +document.getElementById('sale-discount-pct')?.value || 0;
        const taxPct = +document.getElementById('sale-tax-pct')?.value || 0;
        const discount = subtotal * (discPct / 100);
        const tax = (subtotal - discount) * (taxPct / 100);
        const grandTotal = subtotal - discount + tax;
        const discPerLine = discount / lineCount;
        const taxPerLine = tax / lineCount;
        body.querySelectorAll('tr').forEach(row => {
            const da = row.querySelector('[data-field="DiscountAmount"]');
            const ta = row.querySelector('[data-field="TaxAmount"]');
            if (da) da.value = discPerLine.toFixed(4);
            if (ta) ta.value = taxPerLine.toFixed(4);
        });
        const hfDisc = document.getElementById('hf-ItemDiscount');
        const hfTax = document.getElementById('hf-TaxAmount');
        if (hfDisc) hfDisc.value = discount.toFixed(4);
        if (hfTax) hfTax.value = tax.toFixed(4);
        const paid = +document.getElementById('PaidAmount')?.value || 0;
        document.getElementById('sale-subtotal').textContent = fmt(subtotal);
        document.getElementById('sale-discount').textContent = fmt(discount);
        document.getElementById('sale-tax').textContent = fmt(tax);
        document.getElementById('sale-total').textContent = fmt(grandTotal);
        document.getElementById('sale-due').textContent = fmt(Math.max(grandTotal - paid, 0));
        document.getElementById('sale-change').textContent = fmt(paid > grandTotal ? paid - grandTotal : 0);
        if (mobileTotal) mobileTotal.textContent = fmt(grandTotal);
    };

    const reindex = () => [...body.children].forEach((row, n) =>
        row.querySelectorAll('[name]').forEach(input => input.name = input.name.replace(/Items\[\d+\]/, `Items[${n}]`)));

    const add = item => {
        const record = item?.ProductId ? productById(item.ProductId) : null;
        const i = body.children.length;
        const row = document.createElement('tr');
        row.className = 'cart-line';
        row.innerHTML = `<td class="p-3">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <div class="cart-product-name fw-semibold text-truncate" style="min-width:0">${esc(record ? record.name : 'Product')}</div>
                    <button type="button" class="btn btn-sm btn-icon btn-outline-danger remove-line" title="Remove line"><i class="ti ti-x"></i></button>
                </div>
                <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
                    <select name="Items[${i}].ProductUnitId" data-field="ProductUnitId" class="form-select form-select-sm" style="max-width:32%" title="Unit"><option value="">Select unit</option></select>
                    <div class="input-group input-group-sm qty-stepper" style="width:118px">
                        <button type="button" class="btn btn-outline-secondary qty-minus" title="Decrease"><i class="ti ti-minus"></i></button>
                        <input name="Items[${i}].Quantity" data-field="Quantity" value="${item?.Quantity ?? 1}" type="number" min="0.0001" step="1" class="form-control text-center" title="Quantity" />
                        <button type="button" class="btn btn-outline-secondary qty-plus" title="Increase"><i class="ti ti-plus"></i></button>
                    </div>
                    <div class="col">
                        <label class="form-label small mb-1">Price</label>
                        <input name="Items[${i}].UnitPrice" data-field="UnitPrice" value="${item?.UnitPrice ?? record?.salePrice ?? ''}" type="number" min="0" step="0.0001" class="form-control form-control-sm text-end" />
                    </div>
                    <div class="ms-auto text-end">
                        <div class="fw-semibold fs-5" data-total>0.00</div>
                        <small class="text-muted" data-unit-price></small>
                    </div>
                </div>
                <input type="hidden" name="Items[${i}].DiscountAmount" data-field="DiscountAmount" value="0" />
                <input type="hidden" name="Items[${i}].TaxAmount" data-field="TaxAmount" value="0" />
                <div class="sale-row-error text-danger small mt-1"></div>
            </td>`;
        if (record) {
            const hidden = document.createElement('input');
            hidden.type = 'hidden';
            hidden.name = `Items[${i}].ProductId`;
            hidden.dataset.field = 'ProductId';
            hidden.value = record.id;
            row.querySelector('td').appendChild(hidden);
        }
        body.appendChild(row);

        const productId = item?.ProductId ?? '';
        const unit = row.querySelector('[data-field="ProductUnitId"]');
        const qty = row.querySelector('[data-field="Quantity"]');
        const price = row.querySelector('[data-field="UnitPrice"]');
        const applyProduct = () => {
            const record = productById(productId);
            if (record && (+price.value || 0) === 0 && !item?.UnitPrice) price.value = record.salePrice || 0;
            units(unit, productId, item?.ProductUnitId);
            refreshDuplicates(); clearRowError(row); recalc(); markDirty();
        };
        unit.addEventListener('change', () => { clearRowError(row); markDirty(); });
        row.querySelectorAll('[data-field]').forEach(input => input.addEventListener('input', () => { recalc(); clearRowError(row); markDirty(); }));
        row.querySelector('.qty-minus').addEventListener('click', () => {
            const v = +qty.value || 0;
            qty.value = Math.max(v - 1, 1);
            recalc(); clearRowError(row); markDirty();
        });
        row.querySelector('.qty-plus').addEventListener('click', () => {
            qty.value = (+qty.value || 0) + 1;
            recalc(); clearRowError(row); markDirty();
        });
        row.querySelector('.remove-line').addEventListener('click', () => { row.remove(); reindex(); refreshDuplicates(); recalc(); markDirty(); updateCartCount(); });

        applyProduct();
        recalc();
        updateCartCount();
    };

    const quickAdd = id => {
        const record = productById(id);
        if (!record || (+record.availableStock || 0) <= 0) return;
        const existing = [...body.children].find(r => String(r.querySelector('[data-field="ProductId"]')?.value) === String(id));
        if (existing) {
            const qty = existing.querySelector('[data-field="Quantity"]');
            qty.value = (+qty.value || 0) + 1;
            clearRowError(existing); recalc(); markDirty();
            return;
        }
        add({ ProductId: id, Quantity: 1, UnitPrice: record.salePrice });
    };

    const renderGrid = () => {
        const q = (filterBox.value || '').trim().toLowerCase();
        const filtered = products.filter(x => !q || String(x.name).toLowerCase().includes(q));
        grid.innerHTML = filtered.map(x => {
            const outOfStock = (+x.availableStock || 0) <= 0;
            return `<div class="col-6 col-md-4 col-xl-4 col-xxl-3">
                        <button type="button" class="pos-product-tile btn w-100 h-100" data-id="${x.id}" ${outOfStock ? 'disabled' : ''} title="${outOfStock ? 'Out of stock' : ''}">
                            <span class="pos-product-name text-truncate fw-semibold">${esc(x.name)}</span>
                            <span class="d-flex justify-content-between align-items-center mt-2">
                                <span class="pos-tile-price text-success fw-semibold">${fmt(x.salePrice)}</span>
                                <span class="small ${outOfStock ? 'text-danger' : 'text-muted'}">${outOfStock ? 'Out of stock' : `${fmtQty(x.availableStock)} in stock`}</span>
                            </span>
                        </button>
                    </div>`;
        }).join('');
        gridEmpty.classList.toggle('d-none', filtered.length > 0);
        if (gridCount) gridCount.textContent = `${filtered.length} of ${products.length} products`;
        [...grid.querySelectorAll('.pos-product-tile')].forEach(tile => {
            tile.addEventListener('click', () => quickAdd(tile.dataset.id));
        });
    };

    const clearCart = () => {
        body.innerHTML = '';
        reindex(); refreshDuplicates(); recalc(); markDirty(); updateCartCount();
    };

    const setPaid = value => {
        const paid = document.getElementById('PaidAmount');
        if (paid) { paid.value = value; recalc(); }
    };

    const validateHeader = () => {
        let ok = true;
        ['InvoiceNumber', 'SaleDate'].forEach(id => {
            const input = document.getElementById(id);
            if (!input) return;
            const invalid = !String(input.value).trim();
            input.classList.toggle('is-invalid', invalid);
            if (invalid) ok = false;
        });
        const paid = +document.getElementById('PaidAmount')?.value || 0;
        if (paid > 0 && paymentMethod && otherPaymentInput && isOtherPaymentMethodSelected()) {
            const invalid = !String(otherPaymentInput.value).trim();
            otherPaymentInput.classList.toggle('is-invalid', invalid);
            if (invalid) ok = false;
        }
        return ok;
    };

    const isOtherPaymentMethodSelected = () => {
        const selected = paymentMethod?.selectedOptions?.[0];
        return selected && selected.textContent.trim().toLowerCase() === 'other';
    };

    const toggleOtherPaymentMethod = () => {
        if (!otherPaymentWrap || !otherPaymentInput) return;
        const show = isOtherPaymentMethodSelected();
        otherPaymentWrap.style.display = show ? '' : 'none';
        if (!show) {
            otherPaymentInput.value = '';
            otherPaymentInput.classList.remove('is-invalid');
        }
    };

    const validateLines = () => {
        let ok = true; const seen = new Map();
        [...body.children].forEach(row => {
            clearRowError(row);
            const productId = row.querySelector('[data-field="ProductId"]')?.value;
            const unitId = row.querySelector('[data-field="ProductUnitId"]')?.value;
            const qty = +row.querySelector('[data-field="Quantity"]')?.value || 0;
            const price = +row.querySelector('[data-field="UnitPrice"]')?.value || 0;
            const discount = +row.querySelector('[data-field="DiscountAmount"]')?.value || 0;
            const tax = +row.querySelector('[data-field="TaxAmount"]')?.value || 0;
            if (!productId) return;
            if (!unitId) { setRowError(row, 'Select a unit for this product.'); ok = false; return; }
            if (qty <= 0) { setRowError(row, 'Quantity must be greater than zero.'); ok = false; return; }
            if (price < 0 || discount < 0 || tax < 0) { setRowError(row, 'Amounts cannot be negative.'); ok = false; return; }
            if (seen.has(productId)) { setRowError(row, 'Product is already added. Adjust quantity instead.'); seen.get(productId).classList.add('sale-row-invalid'); ok = false; return; }
            const record = productById(productId);
            if (record && qty > (+record.availableStock || 0)) setRowError(row, `Only ${fmtQty(record.availableStock)} unit(s) available. Stock will be validated on save.`);
            seen.set(productId, row);
        });
        if (body.querySelectorAll('tr').length === 0 || ![...body.children].some(r => r.querySelector('[data-field="ProductId"]')?.value)) {
            ok = false;
        }
        return ok;
    };

    const stripEmptyRows = () => {
        [...body.children].forEach(row => { if (!row.querySelector('[data-field="ProductId"]')?.value) row.remove(); });
        reindex();
    };

    const validate = () => {
        lineErrors.style.display = 'none'; lineErrors.textContent = '';
        const headerOk = validateHeader();
        const linesOk = validateLines();
        if (!headerOk || !linesOk) {
            const hasLines = body.querySelectorAll('tr').length > 0 && [...body.children].some(r => r.querySelector('[data-field="ProductId"]')?.value);
            lineErrors.textContent = hasLines ? 'Please correct the highlighted fields above before saving.' : 'Select a product from the catalog to start the sale.';
            lineErrors.style.display = 'block';
            lineErrors.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            return false;
        }
        return true;
    };

    const markDirty = () => { dirty = true; };

    if (form) {
        form.addEventListener('submit', e => {
            if (!validate()) { e.preventDefault(); return; }
            stripEmptyRows();
            submitted = true; dirty = false;
            if (saveButton) { saveButton.disabled = true; if (saveLabel) saveLabel.textContent = 'Saving...'; }
        });
        form.addEventListener('input', e => { if (e.target.matches('input, select, textarea')) markDirty(); });
        form.addEventListener('keydown', e => {
            if (e.key === 'Enter' && e.target.matches('input[type="number"], input[type="search"]')) e.preventDefault();
        });
    }

    window.addEventListener('beforeunload', e => {
        if (dirty && !submitted) { e.preventDefault(); e.returnValue = ''; }
    });

    filterBox.addEventListener('input', renderGrid);
    document.getElementById('PaidAmount')?.addEventListener('input', recalc);
    document.getElementById('sale-discount-pct')?.addEventListener('input', recalc);
    document.getElementById('sale-tax-pct')?.addEventListener('input', recalc);
    document.getElementById('clear-cart')?.addEventListener('click', clearCart);
    mobileBar?.addEventListener('click', () => {
        const open = !cart?.classList.contains('open');
        cart?.classList.toggle('open', open);
        cartBackdrop?.classList.toggle('show', open);
    });
    cartClose?.addEventListener('click', closeCart);
    cartBackdrop?.addEventListener('click', closeCart);
    document.getElementById('pay-exact')?.addEventListener('click', () => {
        const total = +document.getElementById('sale-total').textContent || 0;
        setPaid(total.toFixed(2));
        markDirty();
    });
    document.getElementById('pay-cash')?.addEventListener('click', () => {
        const total = +document.getElementById('sale-total').textContent || 0;
        setPaid(Math.ceil(total));
        markDirty();
    });
    document.getElementById('pay-none')?.addEventListener('click', () => { setPaid(''); markDirty(); });
    paymentMethod?.addEventListener('change', () => { toggleOtherPaymentMethod(); markDirty(); });
    otherPaymentInput?.addEventListener('input', () => { otherPaymentInput.classList.remove('is-invalid'); markDirty(); });

    toggleOtherPaymentMethod();
    initial.forEach(add);
    renderGrid();

    const btnQuickCreate = document.getElementById('btn-quick-create-customer');
    const customerSelect = document.getElementById('CustomerId');
    const appModal = document.getElementById('appModal');
    const appModalBody = document.getElementById('appModalBody');
    const appModalTitle = appModal?.querySelector('.modal-title');

    btnQuickCreate?.addEventListener('click', () => {
        fetch('/Customers/QuickCreate')
            .then(r => { if (!r.ok) throw new Error('Failed to load form'); return r.text(); })
            .then(html => {
                if (appModalBody) appModalBody.innerHTML = html;
                if (appModalTitle) appModalTitle.textContent = 'Quick Create Customer';
                const bsModal = new bootstrap.Modal(appModal);
                bsModal.show();

                const qForm = document.getElementById('quick-customer-form');
                qForm?.addEventListener('submit', e => {
                    e.preventDefault();
                    const btn = qForm.querySelector('[type="submit"]');
                    btn.disabled = true;
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Creating...';

                    fetch('/Customers/QuickCreate', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: new URLSearchParams(new FormData(qForm))
                    })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            const opt = document.createElement('option');
                            opt.value = data.id;
                            opt.textContent = data.name;
                            customerSelect.appendChild(opt);
                            customerSelect.value = data.id;
                            bsModal.hide();
                            if (typeof common !== 'undefined') common.successToast('Customer created successfully.');
                        } else {
                            btn.disabled = false;
                            btn.innerHTML = '<i class="ti ti-plus me-1"></i>Create Customer';
                            if (data.message) {
                                const errDiv = qForm.querySelector('[aspx-validation-summary]');
                                if (errDiv) { errDiv.textContent = data.message; errDiv.style.display = 'block'; }
                            }
                        }
                    })
                    .catch(() => {
                        btn.disabled = false;
                        btn.innerHTML = '<i class="ti ti-plus me-1"></i>Create Customer';
                        if (typeof common !== 'undefined') common.dangerToast('An error occurred while creating the customer.');
                    });
                });
            })
            .catch(() => {
                if (typeof common !== 'undefined') common.dangerToast('Failed to load customer form.');
            });
    });
})();
</script>
