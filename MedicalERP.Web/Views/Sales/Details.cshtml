@model MedicalERP.Application.Sales.Dtos.SaleFormDto
@using MedicalERP.Domain.Enums
@{ ViewData["Title"] = "Sale Invoice"; }
<div class="d-flex justify-content-between align-items-center mb-3"><div><h2 class="mb-1">@Model.InvoiceNumber</h2><span class="badge bg-@(Model.Status == SaleStatus.Confirmed ? "success" : Model.Status == SaleStatus.Cancelled ? "danger" : "warning")">@Model.Status</span> <span class="badge bg-@(Model.PaymentStatus switch { PaymentStatus.Paid => "success", PaymentStatus.PartiallyPaid => "warning", PaymentStatus.Unpaid => "secondary", _ => "info" })">@Model.PaymentStatus</span></div><a asp-action="Index" class="btn btn-outline-secondary">Back</a></div>
@if (TempData["SuccessMessage"] is not null) { <div class="alert alert-success">@TempData["SuccessMessage"]</div> } @if (TempData["ErrorMessage"] is not null) { <div class="alert alert-danger">@TempData["ErrorMessage"]</div> }
<div class="card mb-3"><div class="card-body"><div class="row g-3"><div class="col-md-3"><small class="text-muted d-block">Customer</small><strong>@(Model.CustomerName ?? "Walk-in customer")</strong></div><div class="col-md-3"><small class="text-muted d-block">Warehouse</small><strong>@(Model.WarehouseId?.ToString() ?? "Unassigned")</strong></div><div class="col-md-3"><small class="text-muted d-block">Sale date</small><strong>@Model.SaleDate.ToString("yyyy-MM-dd HH:mm")</strong></div><div class="col-md-3"><small class="text-muted d-block">Register session</small><strong>@(Model.RegisterSessionId.HasValue ? "Open session" : "-")</strong></div></div>@if (!string.IsNullOrWhiteSpace(Model.Notes)) { <hr /><div>@Model.Notes</div> }</div></div>
<div class="card mb-3"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Product</th><th>Unit</th><th class="text-end">Qty</th><th class="text-end">Unit price</th><th class="text-end">Discount</th><th class="text-end">Tax</th><th class="text-end">Line total</th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr><td>@(item.ProductName ?? string.Empty)</td><td>@(item.ProductUnitName ?? string.Empty)</td><td class="text-end">@item.Quantity.ToString("N4")</td><td class="text-end">@item.UnitPrice.ToString("N2")</td><td class="text-end">@item.DiscountAmount.ToString("N2")</td><td class="text-end">@item.TaxAmount.ToString("N2")</td><td class="text-end">@item.NetAmount.ToString("N2")</td></tr>}</tbody><tfoot><tr><th colspan="6" class="text-end">Subtotal</th><th class="text-end">@Model.Subtotal.ToString("N2")</th></tr><tr><th colspan="6" class="text-end">Item discount</th><th class="text-end">@Model.ItemDiscount.ToString("N2")</th></tr><tr><th colspan="6" class="text-end">Tax</th><th class="text-end">@Model.TaxAmount.ToString("N2")</th></tr><tr><th colspan="6" class="text-end">Grand total</th><th class="text-end">@Model.GrandTotal.ToString("N2")</th></tr></tfoot></table></div></div>
@if (Model.Payments.Count > 0) { <div class="card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Payment Method</th><th class="text-end">Amount</th><th>Reference</th></tr></thead><tbody>@foreach (var p in Model.Payments) { <tr><td>@(p.PaymentMethodName ?? string.Empty)</td><td class="text-end">@p.Amount.ToString("N2")</td><td>@(p.ReferenceNumber ?? "-")</td></tr>}</tbody><tfoot><tr><th class="text-end">Paid</th><th class="text-end">@Model.PaidAmount.ToString("N2")</th><th></th></tr><tr><th class="text-end">Change</th><th class="text-end">@Model.ChangeAmount.ToString("N2")</th><th></th></tr><tr><th class="text-end">Due</th><th class="text-end">@Model.DueAmount.ToString("N2")</th><th></th></tr></tfoot></table></div></div> }
