@model MedicalERP.Application.Sales.Dtos.SaleFormDto
@{ ViewData["Title"] = "New Sale"; }
<div class="d-flex justify-content-between align-items-center mb-3"><div><h2 class="mb-1">New Sale</h2><div class="text-muted">Point of sale - pick products from the catalog, then take payment.</div></div><a asp-action="Index" class="btn btn-outline-secondary">Back</a></div>
<form asp-action="Create" method="post" id="sale-form"><partial name="_Form" model="Model" /><div class="d-flex justify-content-end gap-2"><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a><button class="btn btn-primary" data-save-button><i class="ti ti-device-floppy me-1"></i><span data-save-label>Confirm Sale</span></button></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /><partial name="_SaleScripts" /> }
