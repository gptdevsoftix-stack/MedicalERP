@model MedicalERP.Application.Sales.Dtos.SaleFormDto

@using System.Security.Claims
@{
    ViewData["Title"] = $"Receipt - {Model.InvoiceNumber}";
    var companyName = User.FindFirst("company_name")?.Value ?? "MEDICALERP PHARMACY";
    var customerName = Model.CustomerName ?? "Cash Sale Walk-in Customer";
    var totalDiscount = Model.ItemDiscount + Model.InvoiceDiscount;
    var itemCount = Model.Items.Sum(x => x.Quantity);
}

<div class="receipt-actions d-flex justify-content-between align-items-center mb-3 d-print-none">
    <div><h2 class="mb-1">Sale Receipt</h2><div class="text-muted">@Model.InvoiceNumber</div></div>
    <div class="d-flex gap-2">
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Back</a>
        <a asp-action="ReceiptPdf" asp-route-id="@Model.Id" class="btn btn-outline-primary"><i class="ti ti-download me-1"></i>Download PDF</a>
        <button type="button" class="btn btn-primary" onclick="window.print()"><i class="ti ti-printer me-1"></i>Print</button>
    </div>
</div>

<div class="receipt-stage">
    <article class="thermal-receipt" id="receipt">
        <header class="thermal-header">
            <h1>@companyName</h1>
            <strong>(Pharmacy)</strong>
            <p>Quality medicines &amp; healthcare services</p>
        </header>

        <div class="title-strip">Sale Receipt</div>
        <div class="meta-grid">
            <span><b>Bill No:</b> @Model.InvoiceNumber</span><b class="right">Original</b>
            <span><b>Date &amp; Time:</b></span><span class="right">@Model.SaleDate.ToString("dd-MMM-yyyy HH:mm")</span>
            <span class="wide"><b>Customer:</b> @customerName</span>
        </div>

        <table class="items-table">
            <thead><tr><th>Description</th><th>Qty</th><th>Price</th><th>Disc</th><th>Total</th></tr></thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@(item.ProductName ?? "-")<small>@item.ProductUnitName</small></td>
                    <td>@item.Quantity.ToString("0.####")</td>
                    <td>@item.UnitPrice.ToString("N2")</td>
                    <td>@item.DiscountAmount.ToString("N2")</td>
                    <td>@item.NetAmount.ToString("N2")</td>
                </tr>
            }
            </tbody>
            <tfoot><tr><td><b>@Model.Items.Count item(s)</b></td><td><b>@itemCount.ToString("0.####")</b></td><td colspan="2">Item Disc:</td><td>@Model.ItemDiscount.ToString("N2")</td></tr></tfoot>
        </table>

        <div class="totals">
            <div><span>Gross Total:</span><b>@Model.Subtotal.ToString("N2")</b></div>
            @if (Model.InvoiceDiscount > 0) { <div><span>(-) Invoice Disc:</span><b>@Model.InvoiceDiscount.ToString("N2")</b></div> }
            @if (Model.TaxAmount > 0) { <div><span>Tax:</span><b>@Model.TaxAmount.ToString("N2")</b></div> }
            @if (Model.RoundOffAmount != 0) { <div><span>Round Off:</span><b>@Model.RoundOffAmount.ToString("N2")</b></div> }
            <div class="net"><span>Net Total:</span><b>@Model.GrandTotal.ToString("N2")</b></div>
            <div><span>Cash Received:</span><b>@Model.PaidAmount.ToString("N2")</b></div>
            <div><span>Cash Back:</span><b>@Model.ChangeAmount.ToString("N2")</b></div>
            @if (Model.DueAmount > 0) { <div><span>Balance Due:</span><b>@Model.DueAmount.ToString("N2")</b></div> }
        </div>

        <div class="saved"><span>You Saved</span><b>@totalDiscount.ToString("N2")</b></div>
        <div class="operator"><span>User: @User.Identity?.Name</span><span><b>Counter:</b> @(Model.RegisterSessionName ?? "Pharmacy")</span></div>
        <div class="barcode" aria-label="Barcode @Model.InvoiceNumber"></div>
        <div class="barcode-number">@Model.InvoiceNumber</div>

        <footer>
            <p>* No Return or Exchange Without Receipt.<br />* Exchange within 3 days of purchase.<br />* No Cash Refunds.</p>
            <strong>THANK YOU FOR YOUR VISIT</strong>
            <small>Powered by MedicalERP</small>
        </footer>
    </article>
</div>

<style>
    .receipt-stage { display:flex; justify-content:center; padding:1rem; background:#eef0f4; }
    .thermal-receipt { box-sizing:border-box; width:80mm; min-height:150mm; padding:5mm 4mm; background:#fff; color:#111; font-family:"Courier New",monospace; font-size:10px; line-height:1.25; box-shadow:0 4px 18px rgba(0,0,0,.14); }
    .thermal-header { text-align:center; }
    .thermal-header h1 { margin:0; font:700 20px/1.1 Georgia,serif; }
    .thermal-header strong { display:block; font:700 15px/1.2 Georgia,serif; }
    .thermal-header p { margin:3px 0 5px; font-size:9px; }
    .title-strip { margin:3px 0 5px; padding:2px; background:#111; color:#fff; text-align:center; font-weight:700; font-size:11px; }
    .meta-grid { display:grid; grid-template-columns:1fr 1fr; gap:3px 5px; }
    .meta-grid .right { text-align:right; }.meta-grid .wide { grid-column:1/-1; }.meta-grid b { font-family:Georgia,serif; }
    .items-table { width:100%; margin-top:6px; border-collapse:collapse; table-layout:fixed; }
    .items-table th { padding:2px 1px; border-bottom:1px solid #111; text-align:right; font-family:Georgia,serif; }
    .items-table th:first-child,.items-table td:first-child { width:42%; text-align:left; }
    .items-table td { padding:3px 1px; text-align:right; vertical-align:top; overflow-wrap:anywhere; }
    .items-table td small { display:block; color:#444; }.items-table tfoot td { border-top:1px solid #111; border-bottom:1px solid #111; }
    .totals { width:59%; margin:4px 0 0 auto; font-family:Georgia,serif; font-size:11px; }
    .totals div { display:flex; justify-content:space-between; gap:5px; margin:2px 0; }.totals .net { font-size:13px; }
    .saved { display:flex; justify-content:space-between; align-items:baseline; margin:6px 0 3px; padding:2px 3px; border-bottom:2px solid #111; font-family:Arial,sans-serif; font-size:20px; }.saved b { font-size:21px; }
    .operator { display:flex; justify-content:space-between; padding:2px 0 4px; border-bottom:1px solid #111; font-family:Georgia,serif; }
    .barcode { width:39mm; height:15mm; margin:6px auto 1px; background:repeating-linear-gradient(90deg,#111 0,#111 1px,transparent 1px,transparent 3px,#111 3px,#111 5px,transparent 5px,transparent 7px,#111 7px,#111 8px,transparent 8px,transparent 11px); }
    .barcode-number { text-align:center; letter-spacing:2px; font-size:9px; }
    footer { text-align:center; font-family:Georgia,serif; } footer p { margin:5px 0; font-size:9px; } footer strong { display:block; padding-bottom:2px; border-bottom:1px solid #111; font-size:12px; font-style:italic; text-decoration:underline; } footer small { display:block; margin-top:4px; }
    @@media print {
        @@page { size:80mm auto; margin:0; }
        body { background:#fff!important; }.layout-menu,.layout-navbar,.content-backdrop,.d-print-none,.app-brand.demo { display:none!important; }
        .layout-wrapper,.layout-container,.layout-page,.content-wrapper,.container-xxl,.container-p-y { margin:0!important; padding:0!important; max-width:none!important; }
        .receipt-stage { display:block; padding:0; background:#fff; }.thermal-receipt { width:80mm; min-height:0; padding:4mm 3mm; box-shadow:none; }
    }
</style>
