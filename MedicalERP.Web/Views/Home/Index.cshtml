@{
    ViewData["Title"] = "Dashboard";
}

<div class="medical-page-title">
    <h1>Dashboard</h1>
    <p>Medical ERP and POS command center.</p>
</div>

<div class="card hero-card mb-4">
    <div class="card-body d-flex flex-column gap-3">
        <div>
            <h1 class="mb-2">Medical ERP & POS</h1>
            <p class="mb-0">Manage companies, stores, warehouses, users, permissions, and POS operations from a POS-style admin workspace.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-primary" asp-controller="Companies" asp-action="Index"><i class="ti ti-building-skyscraper me-1"></i>Companies</a>
            <a class="btn btn-label-primary" asp-controller="Stores" asp-action="Index"><i class="ti ti-building-store me-1"></i>Stores</a>
            <a class="btn btn-label-secondary" href="/api/permissions"><i class="ti ti-lock me-1"></i>Permissions API</a>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6 col-xl-3">
        <div class="card medical-stat-card"><div class="card-body"><div class="d-flex align-items-center gap-3"><span class="avatar rounded bg-label-primary"><i class="ti ti-building-skyscraper ti-md"></i></span><div><h5 class="mb-1">Companies</h5><p class="mb-0 text-muted">Tenant setup</p></div></div></div></div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card medical-stat-card"><div class="card-body"><div class="d-flex align-items-center gap-3"><span class="avatar rounded bg-label-success"><i class="ti ti-building-store ti-md"></i></span><div><h5 class="mb-1">Stores</h5><p class="mb-0 text-muted">Store operations</p></div></div></div></div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card medical-stat-card"><div class="card-body"><div class="d-flex align-items-center gap-3"><span class="avatar rounded bg-label-warning"><i class="ti ti-building-warehouse ti-md"></i></span><div><h5 class="mb-1">Warehouses</h5><p class="mb-0 text-muted">Stock locations</p></div></div></div></div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card medical-stat-card"><div class="card-body"><div class="d-flex align-items-center gap-3"><span class="avatar rounded bg-label-info"><i class="ti ti-users ti-md"></i></span><div><h5 class="mb-1">Users</h5><p class="mb-0 text-muted">Access control</p></div></div></div></div>
    </div>
</div>
