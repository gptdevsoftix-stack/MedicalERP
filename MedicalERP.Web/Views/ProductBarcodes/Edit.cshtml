@model MedicalERP.Domain.DTOs.ProductBarcodeFormDto

@{
    ViewData["Title"] = "Edit Product Barcode";
    var companyContextId = ViewBag.CompanyContextId as string;
}

<h2>Edit Product Barcode</h2>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <input type="hidden" name="companyContextId" value="@companyContextId" />
    <input asp-for="Id" type="hidden" />
    @await Html.PartialAsync("_ProductBarcodeForm", Model)
    <div class="form-check mb-3">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label"></label>
    </div>
    <button type="submit" class="btn btn-primary">Update</button>
    <a asp-action="Index"
       asp-route-productId="@Model.ProductId"
       asp-route-companyContextId="@companyContextId"
       class="btn btn-secondary">
        Cancel
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
