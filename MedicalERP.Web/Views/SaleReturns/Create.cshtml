@model MedicalERP.Application.Sales.Dtos.SaleReturnFormDto
@{ ViewData["Title"] = $"Return - {Model.InvoiceNumber}"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h2 class="mb-1">Create Sale Return</h2><div class="text-muted">Return items from invoice @Model.InvoiceNumber. Returned stock is added back and a stock transaction is posted.</div></div>
    <a asp-action="Details" asp-controller="Sales" asp-route-id="@Model.SaleId" class="btn btn-outline-secondary">Back</a>
</div>
@if (TempData["ErrorMessage"] is not null) { <div class="alert alert-danger">@TempData["ErrorMessage"]</div> }
<form asp-action="Create" method="post">
    <input type="hidden" asp-for="SaleId" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="card mb-3">
        <div class="card-body py-3">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label asp-for="ReturnNumber" class="form-label"><span class="text-danger">*</span> Return #</label>
                    <input asp-for="ReturnNumber" class="form-control" />
                    <span asp-validation-for="ReturnNumber" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="ReturnDate" class="form-label"><span class="text-danger">*</span> Return Date</label>
                    <input asp-for="ReturnDate" type="datetime-local" class="form-control" />
                    <span asp-validation-for="ReturnDate" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="WarehouseId" class="form-label">Warehouse</label>
                    <select asp-for="WarehouseId" asp-items="ViewBag.Warehouses" class="form-select"><option value="">No warehouse assigned</option></select>
                </div>
                <div class="col-md-3">
                    <label asp-for="Reason" class="form-label">Reason</label>
                    <input asp-for="Reason" class="form-control" placeholder="Optional reason" />
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Batch</th>
                        <th class="text-end">Unit price</th>
                        <th class="text-end">Available</th>
                        <th class="text-end" style="width:130px">Quantity</th>
                        <th class="text-end" style="width:130px">Tax</th>
                        <th class="text-center">Return to stock</th>
                    </tr>
                </thead>
                <tbody id="return-lines">
                    @for (var i = 0; i < Model.Items.Count; i++)
                    {
                        var item = Model.Items[i];
                        <tr data-price="@item.UnitPrice">
                            <td class="fw-semibold">
                                <input type="hidden" name="Items[@i].SaleItemId" value="@item.SaleItemId" />
                                <input type="hidden" name="Items[@i].ProductId" value="@item.ProductId" />
                                <input type="hidden" name="Items[@i].ProductBatchId" value="@item.ProductBatchId" />
                                <input type="hidden" name="Items[@i].ConversionFactor" value="@item.ConversionFactor" />
                                @(item.ProductName ?? string.Empty)
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(item.BatchNumber) ? "-" : item.BatchNumber)</td>
                            <td class="text-end">@item.UnitPrice.ToString("N2")</td>
                            <td class="text-end available-qty" data-available="@item.AvailableQuantity">@item.AvailableQuantity.ToString("N4")</td>
                            <td>
                                <div class="input-group input-group-sm">
                                    <input type="number" name="Items[@i].Quantity" value="@item.Quantity" min="0" max="@item.AvailableQuantity" step="0.0001" class="form-control text-end return-qty" />
                                    <span class="input-group-text">@item.ConversionFactor.ToString("0.####")</span>
                                </div>
                            </td>
                            <td>
                                <input type="number" name="Items[@i].TaxAmount" value="@item.TaxAmount" min="0" step="0.01" class="form-control form-control-sm text-end return-tax" />
                            </td>
                            <td class="text-center">
                                <input type="checkbox" name="Items[@i].ReturnToStock" value="true" class="form-check-input return-to-stock" checked="@item.ReturnToStock" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 offset-md-6">
                    <div class="d-flex justify-content-between py-1"><span class="text-muted">Subtotal</span><strong id="return-subtotal">0.00</strong></div>
                    <div class="d-flex justify-content-between py-1"><span class="text-muted">Tax</span><strong id="return-tax">0.00</strong></div>
                    <div class="d-flex justify-content-between py-2 border-top mt-1"><span class="fw-semibold">Refund amount</span><strong id="return-refund" class="fs-4 text-primary">0.00</strong></div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <a asp-action="Details" asp-controller="Sales" asp-route-id="@Model.SaleId" class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>Post Return</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const recalc = () => {
                let subtotal = 0, tax = 0;
                document.querySelectorAll('#return-lines tr').forEach(row => {
                    const qty = +row.querySelector('.return-qty')?.value || 0;
                    const price = +row.dataset.price || 0;
                    const lineTax = +row.querySelector('.return-tax')?.value || 0;
                    const available = +row.querySelector('.available-qty')?.dataset.available || 0;
                    row.querySelector('.return-qty').classList.toggle('is-invalid', qty < 0 || qty > available);
                    subtotal += qty * price;
                    tax += lineTax;
                });
                document.getElementById('return-subtotal').textContent = subtotal.toFixed(2);
                document.getElementById('return-tax').textContent = tax.toFixed(2);
                document.getElementById('return-refund').textContent = (subtotal + tax).toFixed(2);
            };
            document.querySelectorAll('#return-lines input').forEach(input => input.addEventListener('input', recalc));
            recalc();
        })();
    </script>
}
