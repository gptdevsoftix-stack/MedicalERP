@model MedicalERP.Application.Sales.Dtos.SaleReturnFormDto
@using MedicalERP.Domain.Enums
@{ ViewData["Title"] = "Sale Return"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h2 class="mb-1">@Model.ReturnNumber</h2><span class="badge bg-@(Model.Status switch { ReturnStatus.Posted => "success", ReturnStatus.Cancelled => "danger", _ => "warning" })">@Model.Status</span></div>
    <div class="d-flex gap-2">
        <a asp-action="Details" asp-controller="Sales" asp-route-id="@Model.SaleId" class="btn btn-outline-primary">View Sale</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
    </div>
</div>
@if (TempData["SuccessMessage"] is not null) { <div class="alert alert-success">@TempData["SuccessMessage"]</div> }
<div class="card mb-3"><div class="card-body"><div class="row g-3"><div class="col-md-3"><small class="text-muted d-block">Invoice</small><strong>@Model.InvoiceNumber</strong></div><div class="col-md-3"><small class="text-muted d-block">Warehouse</small><strong>@(Model.WarehouseName ?? "Unassigned")</strong></div><div class="col-md-3"><small class="text-muted d-block">Return date</small><strong>@Model.ReturnDate.ToString("yyyy-MM-dd HH:mm")</strong></div><div class="col-md-3"><small class="text-muted d-block">Status</small><strong>@Model.Status</strong></div></div>@if (!string.IsNullOrWhiteSpace(Model.Reason)) { <hr /><div>@Model.Reason</div> }</div></div>
<div class="card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Product</th><th>Batch</th><th class="text-end">Qty</th><th class="text-end">Unit price</th><th class="text-end">Tax</th><th class="text-end">Line total</th><th class="text-center">Returned to stock</th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr><td>@(item.ProductName ?? string.Empty)</td><td>@(string.IsNullOrWhiteSpace(item.BatchNumber) ? "-" : item.BatchNumber)</td><td class="text-end">@item.Quantity.ToString("N4")</td><td class="text-end">@item.UnitPrice.ToString("N2")</td><td class="text-end">@item.TaxAmount.ToString("N2")</td><td class="text-end">@(item.Quantity * item.UnitPrice + item.TaxAmount).ToString("N2")</td><td class="text-center">@if (item.ReturnToStock) { <i class="ti ti-check text-success"></i> } else { <i class="ti ti-x text-muted"></i> }</td></tr>}</tbody></table></div></div>
