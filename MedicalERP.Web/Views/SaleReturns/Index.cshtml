@model MedicalERP.Application.Common.PagedResult<MedicalERP.Application.Sales.Dtos.SaleReturnListDto>
@using MedicalERP.Domain.Enums
@{
    ViewData["Title"] = "Sale Returns";
    var search = ViewBag.Search as string;
    var status = ViewBag.Status as ReturnStatus?;
    var companyContextId = ViewBag.CompanyContextId as string;
    var totalPages = (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize);
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h2 class="mb-1">Sale Returns</h2><div class="text-muted">Returns that restore stock and post a SaleReturn stock transaction.</div></div>
    <a asp-controller="Sales" asp-action="Index" asp-route-companyContextId="@companyContextId" class="btn btn-outline-primary"><i class="ti ti-arrow-left me-1"></i>Back to Sales</a>
</div>
@if (TempData["SuccessMessage"] is not null) { <div class="alert alert-success">@TempData["SuccessMessage"]</div> }
@if (TempData["ErrorMessage"] is not null) { <div class="alert alert-danger">@TempData["ErrorMessage"]</div> }
<form method="get" class="card card-body mb-3">
    <input type="hidden" name="companyContextId" value="@companyContextId" />
    <div class="row g-2 align-items-end">
        <div class="col-md-4"><label class="form-label">Search</label><input name="search" value="@search" class="form-control" placeholder="Return number or invoice" /></div>
        <div class="col-md-3"><label class="form-label">Status</label><select name="status" class="form-select"><option value="">All statuses</option>@foreach (var item in Enum.GetValues<ReturnStatus>()) { <option value="@item" selected="@(status == item)">@item</option> }</select></div>
        <div class="col-md-2 d-flex gap-2"><button class="btn btn-outline-primary">Filter</button><a asp-action="Index" asp-route-companyContextId="@companyContextId" class="btn btn-outline-secondary">Clear</a></div>
    </div>
</form>
<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Return #</th><th>Invoice</th><th>Date</th><th>Status</th><th class="text-end">Refund</th><th></th></tr></thead><tbody>
@if (Model.Items.Count == 0) { <tr><td colspan="6" class="text-center py-4">No sale returns found.</td></tr> }
@foreach (var item in Model.Items) { <tr><td><a asp-action="Details" asp-route-id="@item.Id" asp-route-companyContextId="@companyContextId" class="fw-semibold">@item.ReturnNumber</a><small class="d-block text-muted">@item.ItemCount line(s)</small></td><td>@(item.InvoiceNumber ?? "-")</td><td>@item.ReturnDate.ToString("yyyy-MM-dd HH:mm")</td><td><span class="badge bg-@(item.Status switch { ReturnStatus.Posted => "success", ReturnStatus.Cancelled => "danger", _ => "warning" })">@item.Status</span></td><td class="text-end">@item.RefundAmount.ToString("N2")</td><td class="text-end"><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Open</a></td></tr> }
</tbody></table></div></div>
@if (totalPages > 1) { <nav class="mt-3"><ul class="pagination">@for (var p = 1; p <= totalPages; p++) { <li class="page-item @(p == Model.Page ? "active" : "")"><a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-pageSize="@Model.PageSize" asp-route-search="@search" asp-route-status="@status" asp-route-companyContextId="@companyContextId">@p</a></li> }</ul></nav> }
