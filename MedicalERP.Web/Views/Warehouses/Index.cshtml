@model PagedResult<MedicalERP.Application.Warehouses.Dtos.WarehouseDto>
@{ ViewData["Title"] = "Warehouses"; }
<div class="medical-page-title d-flex justify-content-between align-items-center"><div><h1>Warehouses</h1><p>Store-scoped warehouse locations.</p></div><a class="btn btn-primary" asp-action="CreatePage"><i class="ti ti-plus me-1"></i>Create</a></div>
<div class="card"><div class="table-responsive"><table class="table"><thead><tr><th>Name</th><th>Code</th><th>Type</th><th>Store</th><th>Default</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td>@item.Name</td><td>@item.Code</td><td>@item.WarehouseType</td><td>@item.StoreId</td><td>@item.IsDefault</td><td>@(item.IsActive ? "Active" : "Inactive")</td><td class="text-end"><a class="btn btn-sm btn-label-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a><form class="d-inline" asp-action="Delete" asp-route-id="@item.Id" method="post"><button class="btn btn-sm btn-label-danger">Delete</button></form></td></tr>}</tbody></table></div></div>
@await Html.PartialAsync("_Pagination", Model)
