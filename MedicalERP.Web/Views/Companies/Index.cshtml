@model PagedResult<MedicalERP.Application.Companies.Dtos.CompanyDto>
@{ ViewData["Title"] = "Companies"; }
<div class="medical-page-title d-flex justify-content-between align-items-center"><div><h1>Companies</h1><p>Manage tenant companies.</p></div><a class="btn btn-primary" asp-action="CreatePage"><i class="ti ti-plus me-1"></i>Create</a></div>
@if (ViewBag.Warning is string warning) { <div class="alert alert-warning">@warning</div> }
<div class="card"><div class="table-responsive text-nowrap"><table class="table"><thead><tr><th>Name</th><th>Code</th><th>Email</th><th>Currency</th><th>Status</th><th></th></tr></thead><tbody>
@foreach (var item in Model.Items) { <tr><td>@item.Name</td><td>@item.Code</td><td>@item.Email</td><td>@item.CurrencyCode</td><td>@(item.IsActive ? "Active" : "Inactive")</td><td class="text-end"><a class="btn btn-sm btn-label-info" asp-controller="Stores" asp-action="Index" asp-route-companyContextId="@item.Id">Stores</a> <a class="btn btn-sm btn-label-success" asp-controller="Products" asp-action="Index" asp-route-companyContextId="@item.Id">Products</a> <a class="btn btn-sm btn-label-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a><form class="d-inline" asp-action="Delete" asp-route-id="@item.Id" method="post"><button class="btn btn-sm btn-label-danger" type="submit">Delete</button></form></td></tr> }
</tbody></table></div></div>
@await Html.PartialAsync("_Pagination", Model)
