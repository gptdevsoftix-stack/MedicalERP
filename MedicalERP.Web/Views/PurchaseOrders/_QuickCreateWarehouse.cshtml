@using MedicalERP.Domain.Enums
<form id="quick-create-warehouse-form">
    <div id="quick-create-warehouse-errors" class="alert alert-danger d-none"></div>

    <div class="row g-3">
        <div class="col-md-6 mb-3">
            <label for="qcw-name" class="form-label">Name <span class="text-danger">*</span></label>
            <input type="text" id="qcw-name" class="form-control" required maxlength="150" placeholder="Warehouse name" />
        </div>
        <div class="col-md-6 mb-3">
            <label for="qcw-code" class="form-label">Code <span class="text-danger">*</span></label>
            <input type="text" id="qcw-code" class="form-control" required maxlength="40" placeholder="e.g. WH-001" />
        </div>
        <div class="col-md-6 mb-3">
            <label for="qcw-type" class="form-label">Type</label>
            <select id="qcw-type" class="form-select">
                <option value="1">Main</option>
                <option value="2">Back Store</option>
                <option value="3">Damaged</option>
                <option value="4">Expired</option>
                <option value="5">Quarantine</option>
            </select>
        </div>
        <div class="col-md-6 mb-3">
            <label for="qcw-address" class="form-label">Address</label>
            <input type="text" id="qcw-address" class="form-control" maxlength="500" placeholder="Optional" />
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-3">
        <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">
            <i class="ti ti-plus me-1"></i>Create Warehouse
        </button>
    </div>
</form>
