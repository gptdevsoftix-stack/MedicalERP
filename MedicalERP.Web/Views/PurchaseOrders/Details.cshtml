@model MedicalERP.Application.Purchases.Dtos.PurchaseOrderFormDto
@using MedicalERP.Domain.Enums
@{ ViewData["Title"] = "Purchase Order"; }
<div class="d-flex justify-content-between align-items-center mb-3"><div><h2 class="mb-1">@Model.OrderNumber</h2><span class="badge bg-@(Model.Status == OrderStatus.Approved ? "success" : Model.Status == OrderStatus.Pending ? "warning" : Model.Status == OrderStatus.Cancelled ? "danger" : "secondary")">@Model.Status</span></div><div class="d-flex gap-2"><a asp-action="Index" class="btn btn-outline-secondary">Back</a>@if (Model.Status == OrderStatus.Draft) { <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Edit</a><form asp-action="Submit" asp-route-id="@Model.Id" method="post"><button class="btn btn-primary">Submit for approval</button></form> } @if (Model.Status == OrderStatus.Pending) { <form asp-action="Approve" asp-route-id="@Model.Id" method="post"><button class="btn btn-success">Approve</button></form> } @if (Model.Status is not OrderStatus.Cancelled and not OrderStatus.Fulfilled and not OrderStatus.Closed) { <form asp-action="Cancel" asp-route-id="@Model.Id" method="post"><button class="btn btn-outline-danger">Cancel</button></form> }</div></div>
@if (TempData["SuccessMessage"] is not null) { <div class="alert alert-success">@TempData["SuccessMessage"]</div> } @if (TempData["ErrorMessage"] is not null) { <div class="alert alert-danger">@TempData["ErrorMessage"]</div> }
<div class="card mb-3"><div class="card-body"><div class="row g-3"><div class="col-md-3"><small class="text-muted d-block">Supplier</small><strong>@Model.SupplierName</strong></div><div class="col-md-3"><small class="text-muted d-block">Warehouse</small><strong>@(Model.WarehouseId?.ToString() ?? "Unassigned")</strong></div><div class="col-md-3"><small class="text-muted d-block">Order date</small><strong>@Model.OrderDate.ToString("yyyy-MM-dd HH:mm")</strong></div><div class="col-md-3"><small class="text-muted d-block">Expected delivery</small><strong>@(Model.ExpectedDeliveryDate?.ToString("yyyy-MM-dd") ?? "-")</strong></div></div>@if (!string.IsNullOrWhiteSpace(Model.Notes)) { <hr /><div>@Model.Notes</div> }</div></div>
<div class="card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Product</th><th>Unit</th><th class="text-end">Qty</th><th class="text-end">Free</th><th class="text-end">Unit price</th><th class="text-end">Discount</th><th class="text-end">Tax</th><th class="text-end">Line total</th></tr></thead><tbody>@foreach (var item in Model.Items) { var total = item.OrderedQuantity * item.UnitPrice - item.DiscountAmount + item.TaxAmount; <tr><td>@item.ProductName</td><td>@item.ProductUnitName</td><td class="text-end">@item.OrderedQuantity.ToString("N4")</td><td class="text-end">@item.FreeQuantity.ToString("N4")</td><td class="text-end">@item.UnitPrice.ToString("N2")</td><td class="text-end">@item.DiscountAmount.ToString("N2")</td><td class="text-end">@item.TaxAmount.ToString("N2")</td><td class="text-end">@total.ToString("N2")</td></tr>}</tbody><tfoot><tr><th colspan="7" class="text-end">Other charges</th><th class="text-end">@Model.OtherCharges.ToString("N2")</th></tr><tr><th colspan="7" class="text-end">Grand total</th><th class="text-end">@((Model.Items.Sum(x => x.OrderedQuantity * x.UnitPrice - x.DiscountAmount + x.TaxAmount) + Model.OtherCharges).ToString("N2"))</th></tr></tfoot></table></div></div>
