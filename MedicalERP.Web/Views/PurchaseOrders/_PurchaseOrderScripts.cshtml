<script>
(() => {
    const products = JSON.parse(document.getElementById('product-data').textContent || '[]');
    const initial = JSON.parse(document.getElementById('initial-items').textContent || '[]');
    const body = document.getElementById('order-lines');
    const form = document.getElementById('po-form');
    const filterBox = document.getElementById('product-filter');
    const lineErrors = document.getElementById('po-line-errors');
    const saveButton = form?.querySelector('[data-save-button]');
    const saveLabel = saveButton?.querySelector('[data-save-label]');
    const esc = value => String(value ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const valueOf = (record, name) => record[name] ?? record[name.charAt(0).toUpperCase() + name.slice(1)];
    const money = value => (+value || 0).toFixed(2);
    let submitted = false;
    let dirty = false;

    const productOptions = (selected, filter) => {
        const q = (filter || '').trim().toLowerCase();
        return '<option value="">Select product</option>' + products
            .filter(x => !q || String(valueOf(x, 'name')).toLowerCase().includes(q))
            .map(x => { const id = valueOf(x, 'id'); return `<option value="${id}" ${String(id) === String(selected) ? 'selected' : ''}>${esc(valueOf(x, 'name'))}</option>`; })
            .join('');
    };

    const units = async (select, productId, selected) => {
        select.innerHTML = '<option value="">Loading...</option>';
        if (!productId) { select.innerHTML = '<option value="">Select unit</option>'; return; }
        try {
            const response = await fetch(`/PurchaseOrders/ProductUnits?productId=${encodeURIComponent(productId)}`);
            if (!response.ok) throw new Error('Request failed');
            const data = await response.json();
            select.innerHTML = '<option value="">Select unit</option>' + data.map(x => { const id = valueOf(x, 'id'); return `<option value="${id}" ${String(id) === String(selected) ? 'selected' : ''}>${esc(valueOf(x, 'name'))}</option>`; }).join('');
        } catch {
            select.innerHTML = '<option value="">Select unit</option><option value="" disabled>Failed to load units</option>';
        }
    };

    const setRowError = (row, message) => {
        let tip = row.querySelector('.po-row-error');
        if (!tip) { tip = document.createElement('td'); tip.colSpan = 9; tip.className = 'po-row-error text-danger small pt-0'; row.appendChild(tip); }
        tip.textContent = message;
        row.classList.add('po-row-invalid');
    };

    const clearRowError = row => {
        const tip = row.querySelector('.po-row-error');
        if (tip) tip.textContent = '';
        row.classList.remove('po-row-invalid');
    };

    const refreshDuplicates = () => {
        const selected = new Set([...body.children].map(r => r.querySelector('[data-field="ProductId"]')?.value).filter(v => v));
        [...body.children].forEach(row => {
            const select = row.querySelector('[data-field="ProductId"]');
            [...select.options].forEach(opt => {
                if (!opt.value) { opt.disabled = false; return; }
                opt.disabled = opt.value !== select.value && selected.has(opt.value);
            });
        });
    };

    const recalc = () => {
        let subtotal = 0, discount = 0, tax = 0;
        body.querySelectorAll('tr').forEach(row => {
            const qty = +row.querySelector('[data-field="OrderedQuantity"]')?.value || 0;
            const price = +row.querySelector('[data-field="UnitPrice"]')?.value || 0;
            const discountAmount = +row.querySelector('[data-field="DiscountAmount"]')?.value || 0;
            const taxAmount = +row.querySelector('[data-field="TaxAmount"]')?.value || 0;
            const line = qty * price - discountAmount + taxAmount;
            row.querySelector('[data-total]').textContent = money(line);
            subtotal += qty * price; discount += discountAmount; tax += taxAmount;
        });
        const charges = +document.getElementById('OtherCharges')?.value || 0;
        document.getElementById('order-subtotal').textContent = money(subtotal);
        document.getElementById('order-discount').textContent = money(discount);
        document.getElementById('order-tax').textContent = money(tax);
        document.getElementById('order-charges').textContent = money(charges);
        document.getElementById('order-total').textContent = money(subtotal - discount + tax + charges);
    };

    const reindex = () => [...body.children].forEach((row, n) =>
        row.querySelectorAll('[name]').forEach(input => input.name = input.name.replace(/Items\[\d+\]/, `Items[${n}]`)));

    const add = item => {
        const i = body.children.length;
        const row = document.createElement('tr');
        row.innerHTML = `<td><select name="Items[${i}].ProductId" data-field="ProductId" class="form-select form-select-sm">${productOptions(item?.ProductId)}</select></td>`
            + `<td><div class="input-group input-group-sm"><select name="Items[${i}].ProductUnitId" data-field="ProductUnitId" class="form-select"><option value="">Select unit</option></select><button type="button" class="btn btn-outline-primary quick-add-unit" title="Add unit"><i class="ti ti-plus"></i></button></div></td>`
            + `<td><input name="Items[${i}].OrderedQuantity" data-field="OrderedQuantity" value="${item?.OrderedQuantity ?? ''}" type="number" min="0.0001" step="0.0001" placeholder="0" class="form-control form-control-sm" /></td>`
            + `<td><input name="Items[${i}].FreeQuantity" data-field="FreeQuantity" value="${item?.FreeQuantity ?? 0}" type="number" min="0" step="0.0001" class="form-control form-control-sm" /></td>`
            + `<td><input name="Items[${i}].UnitPrice" data-field="UnitPrice" value="${item?.UnitPrice ?? 0}" type="number" min="0" step="0.0001" class="form-control form-control-sm" /></td>`
            + `<td><input name="Items[${i}].DiscountAmount" data-field="DiscountAmount" value="${item?.DiscountAmount ?? 0}" type="number" min="0" step="0.0001" class="form-control form-control-sm" /></td>`
            + `<td><input name="Items[${i}].TaxAmount" data-field="TaxAmount" value="${item?.TaxAmount ?? 0}" type="number" min="0" step="0.0001" class="form-control form-control-sm" /></td>`
            + `<td class="text-end" data-total>0.00</td>`
            + `<td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger remove-line" title="Remove line"><i class="ti ti-trash"></i></button></td>`;
        body.appendChild(row);

        const product = row.querySelector('[data-field="ProductId"]');
        const unit = row.querySelector('[data-field="ProductUnitId"]');
        product.addEventListener('change', () => { units(unit, product.value, ''); refreshDuplicates(); clearRowError(row); markDirty(); });
        unit.addEventListener('change', () => { clearRowError(row); markDirty(); });
        row.querySelectorAll('[data-field]').forEach(input => input.addEventListener('input', () => { recalc(); clearRowError(row); markDirty(); }));
        row.querySelector('.remove-line').addEventListener('click', () => { row.remove(); reindex(); refreshDuplicates(); recalc(); markDirty(); });

        units(unit, item?.ProductId, item?.ProductUnitId);
        refreshDuplicates();
        recalc();
    };

    const validateHeader = () => {
        let ok = true;
        ['SupplierId', 'OrderNumber', 'OrderDate'].forEach(id => {
            const input = document.getElementById(id);
            if (!input) return;
            const invalid = !String(input.value).trim();
            input.classList.toggle('is-invalid', invalid);
            if (invalid) ok = false;
        });
        return ok;
    };

    const validateLines = () => {
        let ok = true; const errors = []; const seen = new Map();
        [...body.children].forEach(row => {
            clearRowError(row);
            const productId = row.querySelector('[data-field="ProductId"]')?.value;
            const unitId = row.querySelector('[data-field="ProductUnitId"]')?.value;
            const qty = +row.querySelector('[data-field="OrderedQuantity"]')?.value || 0;
            const price = +row.querySelector('[data-field="UnitPrice"]')?.value || 0;
            const free = +row.querySelector('[data-field="FreeQuantity"]')?.value || 0;
            const discount = +row.querySelector('[data-field="DiscountAmount"]')?.value || 0;
            const tax = +row.querySelector('[data-field="TaxAmount"]')?.value || 0;
            if (!productId) return;
            if (!unitId) { setRowError(row, 'Select a unit for this product.'); ok = false; return; }
            if (qty <= 0) { setRowError(row, 'Quantity must be greater than zero.'); ok = false; return; }
            if (free < 0 || price < 0 || discount < 0 || tax < 0) { setRowError(row, 'Amounts cannot be negative.'); ok = false; return; }
            if (seen.has(productId)) { setRowError(row, 'Product is already added. Adjust quantity instead.'); seen.get(productId).classList.add('po-row-invalid'); ok = false; return; }
            seen.set(productId, row);
        });
        if (body.querySelectorAll('tr').length === 0 || ![...body.children].some(r => r.querySelector('[data-field="ProductId"]')?.value)) {
            ok = false; errors.push('Add at least one product line.');
        }
        return ok;
    };

    const stripEmptyRows = () => {
        [...body.children].forEach(row => { if (!row.querySelector('[data-field="ProductId"]')?.value) row.remove(); });
        reindex();
    };

    const validate = () => {
        lineErrors.style.display = 'none'; lineErrors.textContent = '';
        const headerOk = validateHeader();
        const linesOk = validateLines();
        if (!headerOk || !linesOk) {
            lineErrors.textContent = 'Please correct the highlighted fields above before saving.';
            lineErrors.style.display = 'block';
            lineErrors.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            return false;
        }
        return true;
    };

    const markDirty = () => { dirty = true; };

    if (form) {
        form.addEventListener('submit', e => {
            if (!validate()) { e.preventDefault(); return; }
            stripEmptyRows();
            submitted = true; dirty = false;
            if (saveButton) { saveButton.disabled = true; if (saveLabel) saveLabel.textContent = 'Saving...'; }
        });
        form.addEventListener('input', e => { if (e.target.matches('input, select, textarea')) markDirty(); });
        form.addEventListener('keydown', e => {
            if (e.key === 'Enter' && e.target.matches('input[type="number"], input[type="search"]') && !e.target.closest('.input-group')) e.preventDefault();
        });
    }

    window.addEventListener('beforeunload', e => {
        if (dirty && !submitted) { e.preventDefault(); e.returnValue = ''; }
    });

    document.getElementById('add-line').addEventListener('click', () => { add({}); filterBox.value = ''; });
    filterBox.addEventListener('input', () => {
        [...body.children].forEach(row => {
            const select = row.querySelector('[data-field="ProductId"]');
            const keep = select.value;
            select.innerHTML = productOptions(keep, filterBox.value);
        });
        refreshDuplicates();
    });

    (initial.length ? initial : [{}]).forEach(add);

    const appModal = document.getElementById('appModal');
    const appModalBody = document.getElementById('appModalBody');
    const appModalTitle = appModal?.querySelector('.modal-title');

    body.addEventListener('click', e => {
        const button = e.target.closest('.quick-add-unit');
        if (!button) return;
        const row = button.closest('tr');
        const productId = row?.querySelector('[data-field="ProductId"]')?.value;
        if (!productId) {
            if (typeof common !== 'undefined') common.dangerToast('Select a product first.');
            return;
        }

        fetch(`/PurchaseOrders/QuickCreateProductUnit?productId=${encodeURIComponent(productId)}`)
            .then(r => { if (!r.ok) throw new Error('Failed to load form'); return r.text(); })
            .then(html => {
                if (appModalBody) appModalBody.innerHTML = html;
                if (appModalTitle) appModalTitle.textContent = 'Add Product Unit';
                const bsModal = new bootstrap.Modal(appModal);
                bsModal.show();
                const quickForm = document.getElementById('quick-create-product-unit-form');
                quickForm?.addEventListener('submit', event => {
                    event.preventDefault();
                    if (!quickForm.reportValidity()) return;
                    const submitBtn = quickForm.querySelector('[type="submit"]');
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Creating...';
                    fetch('/PurchaseOrders/QuickCreateProductUnit', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            productId,
                            unitId: document.getElementById('qcpu-unit-id')?.value,
                            conversionFactor: +(document.getElementById('qcpu-conversion')?.value || 1),
                            isPurchaseUnit: true,
                            isActive: true
                        })
                    })
                    .then(async r => ({ ok: r.ok, data: await r.json() }))
                    .then(result => {
                        if (!result.ok || !result.data.success || !result.data.data) throw new Error(result.data.message || 'Failed to create unit.');
                        const unitSelect = row.querySelector('[data-field="ProductUnitId"]');
                        unitSelect.add(new Option(result.data.data.name, result.data.data.id, true, true));
                        clearRowError(row);
                        markDirty();
                        bsModal.hide();
                        if (typeof common !== 'undefined') common.successToast('Product unit created.');
                    })
                    .catch(error => {
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = '<i class="ti ti-plus me-1"></i>Create';
                        const errorBox = quickForm.querySelector('.alert-danger');
                        errorBox.textContent = error.message || 'Failed to create unit.';
                        errorBox.classList.remove('d-none');
                    });
                });
            })
            .catch(() => { if (typeof common !== 'undefined') common.dangerToast('Failed to load unit form.'); });
    });

    function handleQuickCreate(btnId, fetchUrl, formId, postUrl, selectId, buildPayload, displayName) {
        const btn = document.getElementById(btnId);
        btn?.addEventListener('click', () => {
            fetch(fetchUrl)
                .then(r => { if (!r.ok) throw new Error('Failed to load form'); return r.text(); })
                .then(html => {
                    if (appModalBody) appModalBody.innerHTML = html;
                    if (appModalTitle) appModalTitle.textContent = displayName;
                    const bsModal = new bootstrap.Modal(appModal);
                    bsModal.show();

                    const form = document.getElementById(formId);
                    form?.addEventListener('submit', e => {
                        e.preventDefault();
                        const submitBtn = form.querySelector('[type="submit"]');
                        submitBtn.disabled = true;
                        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Creating...';

                        fetch(postUrl, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(buildPayload())
                        })
                        .then(r => r.json())
                        .then(data => {
                            if (data.success && data.data) {
                                const select = document.getElementById(selectId);
                                const opt = document.createElement('option');
                                opt.value = data.data.id;
                                opt.textContent = data.data.name;
                                select.appendChild(opt);
                                select.value = data.data.id;
                                bsModal.hide();
                                if (typeof common !== 'undefined') common.successToast('Created successfully.');
                            } else {
                                submitBtn.disabled = false;
                                submitBtn.innerHTML = '<i class="ti ti-plus me-1"></i>Create';
                                const errDiv = form.querySelector('.alert-danger');
                                if (errDiv) {
                                    errDiv.textContent = data.message || 'Failed to create.';
                                    errDiv.classList.remove('d-none');
                                }
                            }
                        })
                        .catch(() => {
                            submitBtn.disabled = false;
                            submitBtn.innerHTML = '<i class="ti ti-plus me-1"></i>Create';
                            if (typeof common !== 'undefined') common.dangerToast('An error occurred.');
                        });
                    });
                })
                .catch(() => {
                    if (typeof common !== 'undefined') common.dangerToast('Failed to load form.');
                });
        });
    }

    handleQuickCreate(
        'btn-quick-create-supplier',
        '/PurchaseOrders/QuickCreateSupplier',
        'quick-create-supplier-form',
        '/PurchaseOrders/QuickCreateSupplier',
        'SupplierId',
        () => ({
            name: document.getElementById('qcs-name')?.value?.trim() || '',
            code: document.getElementById('qcs-code')?.value?.trim() || '',
            contactPerson: document.getElementById('qcs-contact')?.value?.trim() || null,
            phone: document.getElementById('qcs-phone')?.value?.trim() || null,
            email: document.getElementById('qcs-email')?.value?.trim() || null,
            address: document.getElementById('qcs-address')?.value?.trim() || null
        }),
        'New Supplier'
    );

    handleQuickCreate(
        'btn-quick-create-warehouse',
        '/PurchaseOrders/QuickCreateWarehouse',
        'quick-create-warehouse-form',
        '/PurchaseOrders/QuickCreateWarehouse',
        'WarehouseId',
        () => ({
            name: document.getElementById('qcw-name')?.value?.trim() || '',
            code: document.getElementById('qcw-code')?.value?.trim() || '',
            warehouseType: parseInt(document.getElementById('qcw-type')?.value) || 1,
            address: document.getElementById('qcw-address')?.value?.trim() || null
        }),
        'New Warehouse'
    );
})();
</script>
