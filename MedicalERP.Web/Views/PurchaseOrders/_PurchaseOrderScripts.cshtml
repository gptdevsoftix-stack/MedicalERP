<script>
(() => {
    const products = JSON.parse(document.getElementById('product-data').textContent || '[]');
    const initial = JSON.parse(document.getElementById('initial-items').textContent || '[]');
    const body = document.getElementById('order-lines');
    const esc = value => String(value ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    const valueOf = (record, name) => record[name] ?? record[name.charAt(0).toUpperCase() + name.slice(1)];
    const productOptions = selected => '<option value="">Select product</option>' + products.map(x => { const id = valueOf(x, 'id'); return `<option value="${id}" ${String(id) === String(selected) ? 'selected' : ''}>${esc(valueOf(x, 'name'))}</option>`; }).join('');
    const units = async (select, productId, selected) => { select.innerHTML = '<option value="">Loading...</option>'; if (!productId) { select.innerHTML = '<option value="">Select unit</option>'; return; } const response = await fetch(`/PurchaseOrders/ProductUnits?productId=${encodeURIComponent(productId)}`); const data = await response.json(); select.innerHTML = '<option value="">Select unit</option>' + data.map(x => { const id = valueOf(x, 'id'); return `<option value="${id}" ${String(id) === String(selected) ? 'selected' : ''}>${esc(valueOf(x, 'name'))}</option>`; }).join(''); };
    const recalc = () => { let total = 0; body.querySelectorAll('tr').forEach(row => { const qty = +row.querySelector('[data-field="OrderedQuantity"]').value || 0; const price = +row.querySelector('[data-field="UnitPrice"]').value || 0; const discount = +row.querySelector('[data-field="DiscountAmount"]').value || 0; const tax = +row.querySelector('[data-field="TaxAmount"]').value || 0; const line = qty * price - discount + tax; row.querySelector('[data-total]').textContent = line.toFixed(2); total += line; }); const charges = +(document.getElementById('OtherCharges')?.value || 0); document.getElementById('order-total').textContent = (total + charges).toFixed(2); };
    const add = item => { const i = body.children.length; const row = document.createElement('tr'); row.innerHTML = `<td><select name="Items[${i}].ProductId" data-field="ProductId" class="form-select form-select-sm">${productOptions(item?.ProductId)}</select></td><td><select name="Items[${i}].ProductUnitId" data-field="ProductUnitId" class="form-select form-select-sm"><option value="">Select unit</option></select></td><td><input name="Items[${i}].OrderedQuantity" data-field="OrderedQuantity" value="${item?.OrderedQuantity || ''}" type="number" min="0.0001" step="0.0001" class="form-control form-control-sm" /></td><td><input name="Items[${i}].FreeQuantity" data-field="FreeQuantity" value="${item?.FreeQuantity || 0}" type="number" min="0" step="0.0001" class="form-control form-control-sm" /></td><td><input name="Items[${i}].UnitPrice" data-field="UnitPrice" value="${item?.UnitPrice || 0}" type="number" min="0" step="0.0001" class="form-control form-control-sm" /></td><td><input name="Items[${i}].DiscountAmount" data-field="DiscountAmount" value="${item?.DiscountAmount || 0}" type="number" min="0" step="0.0001" class="form-control form-control-sm" /></td><td><input name="Items[${i}].TaxAmount" data-field="TaxAmount" value="${item?.TaxAmount || 0}" type="number" min="0" step="0.0001" class="form-control form-control-sm" /></td><td data-total>0.00</td><td><button type="button" class="btn btn-sm btn-outline-danger remove-line" title="Remove line"><i class="ti ti-trash"></i></button></td>`; body.appendChild(row); const product = row.querySelector('[data-field="ProductId"]'); const unit = row.querySelector('[data-field="ProductUnitId"]'); product.addEventListener('change', () => units(unit, product.value, '')); row.addEventListener('input', recalc); row.querySelector('.remove-line').addEventListener('click', () => { row.remove(); [...body.children].forEach((r, n) => r.querySelectorAll('[name]').forEach(input => input.name = input.name.replace(/Items\[\d+\]/, `Items[${n}]`))); recalc(); }); units(unit, item?.ProductId, item?.ProductUnitId); recalc(); };
    (initial.length ? initial : [{}]).forEach(add); document.getElementById('add-line').addEventListener('click', () => add({})); document.getElementById('OtherCharges')?.addEventListener('input', recalc); recalc();
})();
</script>
