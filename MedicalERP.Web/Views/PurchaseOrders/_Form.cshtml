@model MedicalERP.Application.Purchases.Dtos.PurchaseOrderFormDto
@using System.Text.Json
@{ var products = (IEnumerable<MedicalERP.Application.Purchases.Dtos.PurchaseLookupDto>)ViewBag.Products; }
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="card mb-3"><div class="card-body"><div class="row g-3"><div class="col-md-4"><label asp-for="SupplierId" class="form-label"></label><select asp-for="SupplierId" asp-items="ViewBag.Suppliers" class="form-select"><option value="">Select supplier</option></select><span asp-validation-for="SupplierId" class="text-danger"></span></div><div class="col-md-4"><label asp-for="WarehouseId" class="form-label"></label><select asp-for="WarehouseId" asp-items="ViewBag.Warehouses" class="form-select"><option value="">No warehouse assigned</option></select></div><div class="col-md-4"><label asp-for="OrderNumber" class="form-label"></label><input asp-for="OrderNumber" class="form-control" /><span asp-validation-for="OrderNumber" class="text-danger"></span></div><div class="col-md-4"><label asp-for="OrderDate" class="form-label"></label><input asp-for="OrderDate" type="datetime-local" class="form-control" /></div><div class="col-md-4"><label asp-for="ExpectedDeliveryDate" class="form-label"></label><input asp-for="ExpectedDeliveryDate" type="datetime-local" class="form-control" /></div><div class="col-md-4"><label asp-for="OtherCharges" class="form-label"></label><input asp-for="OtherCharges" type="number" step="0.0001" class="form-control" /></div><div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="2"></textarea></div></div></div></div>
<div class="card"><div class="card-header d-flex justify-content-between align-items-center"><h5 class="mb-0">Order Lines</h5><button type="button" id="add-line" class="btn btn-sm btn-outline-primary"><i class="ti ti-plus me-1"></i>Add line</button></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th style="min-width:220px">Product</th><th style="min-width:170px">Unit</th><th>Qty</th><th>Free</th><th>Unit Price</th><th>Discount</th><th>Tax</th><th>Total</th><th></th></tr></thead><tbody id="order-lines"></tbody></table></div><div class="card-footer text-end"><span class="text-muted me-2">Estimated total</span><strong id="order-total">0.00</strong></div></div>
<script id="product-data" type="application/json">@Html.Raw(JsonSerializer.Serialize(products))</script>
<script id="initial-items" type="application/json">@Html.Raw(JsonSerializer.Serialize(Model.Items))</script>
