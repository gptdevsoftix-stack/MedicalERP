@model PagedResult<MedicalERP.Application.Purchases.Dtos.PurchaseOrderListDto>
@using MedicalERP.Domain.Enums
@{
    ViewData["Title"] = "Purchase Orders";
    var search = ViewBag.Search as string;
    var status = ViewBag.Status as OrderStatus?;
    var companyContextId = ViewBag.CompanyContextId as string;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h2 class="mb-1">Purchase Orders</h2><div class="text-muted">Manage supplier orders through draft, approval, and receipt preparation.</div></div>
    <a asp-action="Create" asp-route-companyContextId="@companyContextId" class="btn btn-primary"><i class="ti ti-plus me-1"></i>New Purchase Order</a>
</div>
@if (TempData["SuccessMessage"] is not null) { <div class="alert alert-success">@TempData["SuccessMessage"]</div> }
@if (TempData["ErrorMessage"] is not null) { <div class="alert alert-danger">@TempData["ErrorMessage"]</div> }
<form method="get" class="card card-body mb-3">
    <input type="hidden" name="companyContextId" value="@companyContextId" />
    <div class="row g-2 align-items-end">
        <div class="col-md-5"><label class="form-label">Search</label><input name="search" value="@search" class="form-control" placeholder="Order number or supplier" /></div>
        <div class="col-md-4"><label class="form-label">Status</label><select name="status" class="form-select"><option value="">All statuses</option>@foreach (var item in Enum.GetValues<OrderStatus>()) { <option value="@item" selected="@(status == item)">@item</option> }</select></div>
        <div class="col-md-3 d-flex gap-2"><button class="btn btn-outline-primary">Filter</button><a asp-action="Index" asp-route-companyContextId="@companyContextId" class="btn btn-outline-secondary">Clear</a></div>
    </div>
</form>
<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Order</th><th>Supplier</th><th>Order Date</th><th>Delivery</th><th>Status</th><th class="text-end">Total</th><th></th></tr></thead><tbody>
@if (Model.Items.Count == 0) { <tr><td colspan="7" class="text-center py-4">No purchase orders found.</td></tr> }
@foreach (var item in Model.Items) { <tr><td><a asp-action="Details" asp-route-id="@item.Id" asp-route-companyContextId="@companyContextId" class="fw-semibold">@item.OrderNumber</a><small class="d-block text-muted">@item.ItemCount line(s)</small></td><td>@item.SupplierName</td><td>@item.OrderDate.ToString("yyyy-MM-dd")</td><td>@(item.ExpectedDeliveryDate?.ToString("yyyy-MM-dd") ?? "-")</td><td><span class="badge bg-@(item.Status switch { OrderStatus.Approved => "success", OrderStatus.Pending => "warning", OrderStatus.Cancelled => "danger", OrderStatus.Fulfilled => "primary", _ => "secondary" })">@item.Status</span></td><td class="text-end">@item.GrandTotal.ToString("N2")</td><td class="text-end"><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Open</a></td></tr> }
</tbody></table></div></div>
@await Html.PartialAsync("_Pagination", Model)
