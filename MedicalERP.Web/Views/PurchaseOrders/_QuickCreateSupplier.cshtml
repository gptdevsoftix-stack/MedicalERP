<form id="quick-create-supplier-form">
    <div id="quick-create-supplier-errors" class="alert alert-danger d-none"></div>

    <div class="row g-3">
        <div class="col-md-6 mb-3">
            <label for="qcs-name" class="form-label">Name <span class="text-danger">*</span></label>
            <input type="text" id="qcs-name" class="form-control" required maxlength="150" placeholder="Supplier name" />
        </div>
        <div class="col-md-6 mb-3">
            <label for="qcs-code" class="form-label">Code <span class="text-danger">*</span></label>
            <input type="text" id="qcs-code" class="form-control" required maxlength="40" placeholder="e.g. SUP-001" />
        </div>
        <div class="col-md-6 mb-3">
            <label for="qcs-contact" class="form-label">Contact Person</label>
            <input type="text" id="qcs-contact" class="form-control" maxlength="120" placeholder="Optional" />
        </div>
        <div class="col-md-6 mb-3">
            <label for="qcs-phone" class="form-label">Phone</label>
            <input type="text" id="qcs-phone" class="form-control" maxlength="40" placeholder="Optional" />
        </div>
        <div class="col-md-6 mb-3">
            <label for="qcs-email" class="form-label">Email</label>
            <input type="email" id="qcs-email" class="form-control" maxlength="256" placeholder="Optional" />
        </div>
        <div class="col-md-6 mb-3">
            <label for="qcs-address" class="form-label">Address</label>
            <input type="text" id="qcs-address" class="form-control" maxlength="500" placeholder="Optional" />
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-3">
        <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">
            <i class="ti ti-plus me-1"></i>Create Supplier
        </button>
    </div>
</form>
