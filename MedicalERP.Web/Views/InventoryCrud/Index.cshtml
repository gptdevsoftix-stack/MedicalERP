@model IReadOnlyCollection<object>
@using MedicalERP.Application.Permissions
@using MedicalERP.Domain.Common
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    var title = (string)ViewBag.Title;
    var typeKey = (string)ViewBag.TypeKey;
    var fields = (string[])ViewBag.Fields;
    var labels = (Dictionary<string, string>)ViewBag.FieldLabels;
    var entityType = (Type)ViewBag.EntityType;
    var definitions = (IReadOnlyCollection<SelectListItem>)ViewBag.Definitions;
    var optionMaps = (Dictionary<string, Dictionary<string, string>>)ViewBag.OptionMaps;
    var companyContextId = ViewBag.CompanyContextId as string;
    var canWrite = User.HasClaim(PermissionClaimTypes.Permission, Permissions.Inventory.Adjust)
        || User.HasClaim(PermissionClaimTypes.Permission, Permissions.Inventory.Count)
        || User.HasClaim(PermissionClaimTypes.Permission, Permissions.Inventory.Dispose);
    var isInventoryStocks = string.Equals(typeKey, "InventoryStocks", StringComparison.OrdinalIgnoreCase);
    var isStockTransactions = string.Equals(typeKey, "StockTransactions", StringComparison.OrdinalIgnoreCase);
    var hiddenFields = isInventoryStocks
        ? new HashSet<string>(new[] { "StoreId", "WarehouseId", "ProductBatchId" }, StringComparer.OrdinalIgnoreCase)
        : new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    var displayFields = fields.Where(field => !hiddenFields.Contains(field)).ToArray();
    var productCategories = ViewBag.ProductCategories as Dictionary<Guid, string> ?? new Dictionary<Guid, string>();
    var productNames = ViewBag.ProductNames as Dictionary<Guid, string> ?? new Dictionary<Guid, string>();
    var storeNames = ViewBag.StoreNames as Dictionary<Guid, string> ?? new Dictionary<Guid, string>();
    var categories = ViewBag.Categories as IReadOnlyCollection<SelectListItem>;
    var categoryId = ViewBag.CategoryId as Guid?;

    string FieldLabel(string field)
        => (isInventoryStocks || isStockTransactions) && field == "ProductId" ? "Product" : labels[field];

    string DisplayCategory(object record)
    {
        var productId = entityType.GetProperty("ProductId")?.GetValue(record);
        if (productId is Guid id && productCategories.TryGetValue(id, out var name))
        {
            return name;
        }

        return "-";
    }

    string Display(object record, string field)
    {
        var value = entityType.GetProperty(field)?.GetValue(record);

        if ((isInventoryStocks || isStockTransactions) && field == "ProductId")
        {
            if (value is Guid productId && productNames.TryGetValue(productId, out var productName))
            {
                return productName;
            }

            return "-";
        }

        if (isStockTransactions && field == "StoreId")
        {
            if (value is Guid storeId && storeNames.TryGetValue(storeId, out var storeName))
            {
                return storeName;
            }

            return "-";
        }

        var raw = value?.ToString();
        if (!string.IsNullOrWhiteSpace(raw)
            && optionMaps.TryGetValue(field, out var map)
            && map.TryGetValue(raw, out var label))
        {
            return label;
        }

        return value switch
        {
            null => "-",
            DateOnly date => date.ToString("yyyy-MM-dd"),
            DateTimeOffset date => date.ToString("yyyy-MM-dd HH:mm"),
            decimal number => number.ToString("0.####"),
            bool flag => flag ? "Yes" : "No",
            _ => value.ToString() ?? "-"
        };
    }
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h4 class="mb-1">@title</h4>
        <p class="text-muted mb-0">Inventory CRUD records</p>
    </div>
    <div class="d-flex gap-2">
        <form asp-action="Index" method="get" class="d-flex gap-2">
            <input type="hidden" name="companyContextId" value="@companyContextId" />
            <select name="type" class="form-select" asp-items="definitions" onchange="this.form.submit()"></select>
        </form>
        @if (canWrite && !isInventoryStocks)
        {
            <a asp-action="Create"
               asp-route-type="@typeKey"
               asp-route-companyContextId="@companyContextId"
               class="btn btn-primary">
                <i class="ti ti-plus me-1"></i>Create
            </a>
        }
    </div>
</div>

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success">@message</div>
}

@if (isInventoryStocks)
{
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        <form asp-action="Index" method="get" class="d-flex gap-2 align-items-center">
            <input type="hidden" name="type" value="@typeKey" />
            <input type="hidden" name="companyContextId" value="@companyContextId" />
            <label class="form-label mb-0 text-nowrap" for="categoryId">Category</label>
            <select name="categoryId" id="categoryId" class="form-select">
                <option value="">All Categories</option>
                @if (categories is not null)
                {
                    foreach (var option in categories)
                    {
                        <option value="@option.Value" selected="@(option.Value == categoryId?.ToString())">@option.Text</option>
                    }
                }
            </select>
            <button class="btn btn-outline-primary">Filter</button>
                <a asp-action="Index"
                   asp-route-type="@typeKey"
                   asp-route-companyContextId="@companyContextId"
                   class="btn btn-outline-secondary">Clear</a>
            </form>
    </div>
}

<div class="card">
    <div class="table-responsive text-nowrap">
        <table class="table table-hover">
            <thead>
                <tr>
                    @foreach (var field in displayFields.Take(7))
                    {
                        <th>@FieldLabel(field)</th>
                    }
                    @if (isInventoryStocks)
                    {
                        <th>Category</th>
                    }
                    <th>Active</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="@(displayFields.Take(7).Count() + (isInventoryStocks ? 1 : 0) + 2)" class="text-center text-muted py-4">No records found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var record in Model)
                    {
                        var entity = (BaseEntity)record;
                        <tr>
                            @foreach (var field in displayFields.Take(7))
                            {
                                <td>@Display(record, field)</td>
                            }
                            @if (isInventoryStocks)
                            {
                                <td>@DisplayCategory(record)</td>
                            }
                            <td>
                                <span class="badge bg-label-@(entity.IsActive ? "success" : "secondary")">@(entity.IsActive ? "Active" : "Inactive")</span>
                            </td>
                            <td class="text-end">
                                @if (canWrite)
                                {
                                    <a asp-action="Edit"
                                       asp-route-type="@typeKey"
                                       asp-route-id="@entity.Id"
                                       asp-route-companyContextId="@companyContextId"
                                       class="btn btn-sm btn-icon btn-label-secondary"
                                       title="Edit">
                                        <i class="ti ti-pencil"></i>
                                    </a>
                                    <a asp-action="Delete"
                                       asp-route-type="@typeKey"
                                       asp-route-id="@entity.Id"
                                       asp-route-companyContextId="@companyContextId"
                                       class="btn btn-sm btn-icon btn-label-danger"
                                       title="Delete">
                                        <i class="ti ti-trash"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
