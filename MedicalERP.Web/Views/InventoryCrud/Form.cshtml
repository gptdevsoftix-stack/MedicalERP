@model object
@using MedicalERP.Domain.Common
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    var title = (string)ViewBag.Title;
    var mode = (string)ViewBag.Mode;
    var typeKey = (string)ViewBag.TypeKey;
    var fields = (string[])ViewBag.Fields;
    var labels = (Dictionary<string, string>)ViewBag.FieldLabels;
    var entityType = (Type)ViewBag.EntityType;
    var options = (Dictionary<string, List<SelectListItem>>)ViewBag.Options;
    var companyContextId = ViewBag.CompanyContextId as string;
    var entity = (BaseEntity)Model;
    var isCreate = string.Equals(mode, "Create", StringComparison.OrdinalIgnoreCase);

    Type FieldType(string field) => entityType.GetProperty(field)?.PropertyType ?? typeof(string);
    object? FieldValue(string field) => entityType.GetProperty(field)?.GetValue(Model);
    string InputValue(string field)
    {
        var value = FieldValue(field);
        return value switch
        {
            null => string.Empty,
            DateOnly date => date.ToString("yyyy-MM-dd"),
            DateTimeOffset date => date.ToString("yyyy-MM-ddTHH:mm"),
            decimal number => number.ToString("0.####"),
            _ => value.ToString() ?? string.Empty
        };
    }

    bool IsNullable(Type type) => Nullable.GetUnderlyingType(type) is not null;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1">@mode @title</h4>
        <p class="text-muted mb-0">Fill the fields and save the record.</p>
    </div>
    <a asp-action="Index"
       asp-route-type="@typeKey"
       asp-route-companyContextId="@companyContextId"
       class="btn btn-label-secondary">
        <i class="ti ti-arrow-left me-1"></i>Back
    </a>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="@mode" asp-route-type="@typeKey" asp-route-id="@entity.Id" method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="companyContextId" value="@companyContextId" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @foreach (var field in fields)
            {
                var fieldType = FieldType(field);
                var baseType = Nullable.GetUnderlyingType(fieldType) ?? fieldType;
                var currentValue = InputValue(field);
                <div class="col-md-6">
                    @if (baseType == typeof(bool))
                    {
                        <div class="form-check mt-4">
                            <input class="form-check-input" type="checkbox" name="@field" value="true" id="@field" @(currentValue == "True" ? "checked" : null) />
                            <label class="form-check-label" for="@field">@labels[field]</label>
                        </div>
                    }
                    else
                    {
                        <label class="form-label" for="@field">@labels[field]</label>
                        if (options.TryGetValue(field, out var selectOptions))
                        {
                            <select class="form-select" name="@field" id="@field">
                                @if (IsNullable(fieldType))
                                {
                                    <option value="">Select @labels[field]</option>
                                }
                                @foreach (var option in selectOptions)
                                {
                                    <option value="@option.Value" selected="@(option.Value == currentValue)">@option.Text</option>
                                }
                            </select>
                        }
                        else if (baseType == typeof(DateOnly))
                        {
                            <input class="form-control" type="date" name="@field" id="@field" value="@currentValue" />
                        }
                        else if (baseType == typeof(DateTimeOffset))
                        {
                            <input class="form-control" type="datetime-local" name="@field" id="@field" value="@currentValue" />
                        }
                        else if (baseType == typeof(decimal))
                        {
                            <input class="form-control" type="number" step="0.01" name="@field" id="@field" value="@currentValue" />
                        }
                        else if (field.Contains("Notes", StringComparison.OrdinalIgnoreCase))
                        {
                            <textarea class="form-control" name="@field" id="@field" rows="3">@currentValue</textarea>
                        }
                        else
                        {
                            <input class="form-control" type="text" name="@field" id="@field" value="@currentValue" />
                        }
                        <span class="text-danger field-validation-valid" data-valmsg-for="@field" data-valmsg-replace="true"></span>
                    }
                </div>
            }

            <div class="col-12">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="IsActive" @(entity.IsActive || isCreate ? "checked" : null) />
                    <label class="form-check-label" for="IsActive">Active</label>
                </div>
            </div>

            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>Save</button>
                <a asp-action="Index"
                   asp-route-type="@typeKey"
                   asp-route-companyContextId="@companyContextId"
                   class="btn btn-label-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
