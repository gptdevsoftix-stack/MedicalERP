@model dynamic

@{
    int page = Model.Page;
    int pageSize = Model.PageSize;
    int totalCount = Model.TotalCount;
    int totalPages = (int)Math.Ceiling(totalCount / (double)pageSize);
    var routeValues = (IDictionary<string, object?>)ViewBag.PaginationRouteValues;
    var stringRouteValues = routeValues.ToDictionary(
        kvp => kvp.Key,
        kvp => kvp.Value?.ToString() ?? string.Empty);
}

@if (totalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination mb-0">
            @if (page > 1)
            {
                var prevValues = new Dictionary<string, string>(stringRouteValues) { ["page"] = (page - 1).ToString(), ["pageSize"] = pageSize.ToString() };
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-all-route-data="prevValues">
                        <i class="ti ti-chevron-left"></i>
                    </a>
                </li>
            }

            @for (var p = 1; p <= totalPages; p++)
            {
                if (p == 1 || p == totalPages || (p >= page - 2 && p <= page + 2))
                {
                    var pValues = new Dictionary<string, string>(stringRouteValues) { ["page"] = p.ToString(), ["pageSize"] = pageSize.ToString() };
                    <li class="page-item @(p == page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-all-route-data="pValues">@p</a>
                    </li>
                }
                else if (p == page - 3 || p == page + 3)
                {
                    <li class="page-item disabled">
                        <span class="page-link">&hellip;</span>
                    </li>
                }
            }

            @if (page < totalPages)
            {
                var nextValues = new Dictionary<string, string>(stringRouteValues) { ["page"] = (page + 1).ToString(), ["pageSize"] = pageSize.ToString() };
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-all-route-data="nextValues">
                        <i class="ti ti-chevron-right"></i>
                    </a>
                </li>
            }
        </ul>
    </nav>
}
