@model MedicalERP.Web.Models.RoleFormViewModel
@{
    var grouped = Model.Permissions
        .GroupBy(p => p.Value.Split('.')[0])
        .OrderBy(g => g.Key)
        .ToList();
}
<style>
    .perm-grid-wrap { background: var(--bs-body-bg, #fff); border: 1px solid var(--bs-border-color, #dee2e6); border-radius: .5rem; padding: 1rem; }
    .perm-grid-toolbar { display: flex; align-items: center; gap: .75rem; padding-bottom: .75rem; border-bottom: 1px solid var(--bs-border-color, #dee2e6); margin-bottom: .75rem; }
    .perm-grid-toolbar .form-check { margin-bottom: 0; }
    .perm-group { border: 1px solid var(--bs-border-color, #dee2e6); border-radius: .375rem; overflow: hidden; }
    .perm-group-header { display: flex; align-items: center; gap: .5rem; padding: .5rem .75rem; background: var(--bs-primary); color: var(--bs-body-bg, #fff); font-weight: 600; font-size: .85rem; }
    .perm-group-header .form-check-input { background-color: var(--bs-body-bg, #fff); border-color: var(--bs-body-bg, #fff); }
    .perm-group-header .form-check-input:checked { background-color: var(--bs-body-bg, #fff); border-color: var(--bs-body-bg, #fff); }
    .perm-group-header .form-check-label { color: var(--bs-body-bg, #fff); font-size: .85rem; margin-bottom: 0; }
    .perm-group-body { padding: .5rem .75rem; background: var(--bs-body-bg, #fff); }
    .perm-group-body .form-check { padding-left: 1.75rem; margin-bottom: .35rem; }
    .perm-group-body .form-check:last-child { margin-bottom: 0; }
    .perm-group-body .form-check-label { font-size: .8rem; color: var(--bs-body-color, #212529); }
    .perm-group-body .form-check-label small { color: var(--bs-secondary-color, #6c757d); }
</style>
<div class="col-12">
    <div class="perm-grid-wrap">
        <div class="perm-grid-toolbar">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="selectAll" />
                <label class="form-check-label fw-semibold" for="selectAll">Select All</label>
            </div>
            <span class="text-muted small">@Model.Permissions.Count permissions</span>
        </div>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-3">
            @foreach (var group in grouped)
            {
                <div class="col">
                    <div class="perm-group h-100">
                        <div class="perm-group-header">
                            <input class="form-check-input group-select-all" type="checkbox"
                                   id="select_@group.Key" data-group="@group.Key" />
                            <label class="form-check-label" for="select_@group.Key">@group.Key</label>
                            <span class="ms-auto opacity-75 small">@group.Count()</span>
                        </div>
                        <div class="perm-group-body">
                            @foreach (var perm in group)
                            {
                                var isChecked = Model.SelectedPermissions.Contains(perm.Value);
                                var action = perm.Value.Split('.')[1];
                                <div class="form-check">
                                    <input class="form-check-input perm-cb" type="checkbox"
                                           name="SelectedPermissions" value="@perm.Value"
                                           id="perm_@perm.Value.Replace(".", "_")"
                                           data-group="@group.Key"
                                           @(isChecked ? "checked" : "") />
                                    <label class="form-check-label" for="perm_@perm.Value.Replace(".", "_")">@action</label>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var allCb = document.getElementById('selectAll');
        var permCbs = document.querySelectorAll('.perm-cb');
        var groupHeaders = document.querySelectorAll('.group-select-all');

        function syncGroupHeader(groupId) {
            var groupCbs = document.querySelectorAll('.perm-cb[data-group="' + groupId + '"]');
            var header = document.querySelector('.group-select-all[data-group="' + groupId + '"]');
            if (!header) return;
            header.checked = groupCbs.length > 0 && Array.from(groupCbs).every(function (c) { return c.checked; });
        }

        permCbs.forEach(function (cb) {
            cb.addEventListener('change', function () {
                syncGroupHeader(cb.dataset.group);
                allCb.checked = permCbs.length > 0 && Array.from(permCbs).every(function (c) { return c.checked; });
            });
        });

        groupHeaders.forEach(function (hdr) {
            hdr.addEventListener('change', function () {
                var groupCbs = document.querySelectorAll('.perm-cb[data-group="' + hdr.dataset.group + '"]');
                groupCbs.forEach(function (c) { c.checked = hdr.checked; });
                allCb.checked = permCbs.length > 0 && Array.from(permCbs).every(function (c) { return c.checked; });
            });
        });

        allCb.addEventListener('change', function () {
            permCbs.forEach(function (c) { c.checked = allCb.checked; });
            groupHeaders.forEach(function (h) { h.checked = allCb.checked; });
        });
    });
</script>
