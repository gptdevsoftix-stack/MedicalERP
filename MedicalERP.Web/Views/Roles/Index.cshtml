@model IReadOnlyList<MedicalERP.Application.Identity.Dtos.RoleDto>
@{ ViewData["Title"] = "Roles"; }
<div class="medical-page-title d-flex justify-content-between align-items-center"><div><h1>Roles</h1><p>Role permissions.</p></div><a class="btn btn-primary" asp-action="CreatePage"><i class="ti ti-plus me-1"></i>Create</a></div>
<div class="card"><div class="table-responsive"><table class="table"><thead><tr><th>Name</th><th>Description</th><th>Permissions</th><th>System</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.Name</td><td>@item.Description</td><td>@item.Permissions.Count</td><td>@item.IsSystemRole</td><td>@(item.IsActive ? "Active" : "Inactive")</td><td class="text-end"><a class="btn btn-sm btn-label-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a><form class="d-inline" asp-action="Delete" asp-route-id="@item.Id" method="post"><button class="btn btn-sm btn-label-danger">Delete</button></form></td></tr>}</tbody></table></div></div>
