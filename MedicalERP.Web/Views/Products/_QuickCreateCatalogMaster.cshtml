@using MedicalERP.Domain.Enums
@{
    var masterType = (CatalogMasterType)ViewBag.MasterType;
    var title = masterType switch
    {
        CatalogMasterType.Category => "Category",
        CatalogMasterType.ProductBrand => "Product Brand",
        CatalogMasterType.Manufacturer => "Manufacturer",
        CatalogMasterType.GenericMedicine => "Generic Medicine",
        CatalogMasterType.DosageForm => "Dosage Form",
        CatalogMasterType.Strength => "Strength",
        CatalogMasterType.Unit => "Unit",
        _ => "Item"
    };
}

<form id="quick-create-form" data-master-type="@((int)masterType)">
    <div id="quick-create-errors" class="alert alert-danger d-none"></div>

    <div class="mb-3">
        <label for="qc-name" class="form-label">Name <span class="text-danger">*</span></label>
        <input type="text" id="qc-name" class="form-control" required maxlength="150" placeholder="Enter @title.ToLower() name" />
    </div>

    @if (masterType is CatalogMasterType.Category or CatalogMasterType.ProductBrand
        or CatalogMasterType.Manufacturer or CatalogMasterType.DosageForm)
    {
        <div class="mb-3">
            <label for="qc-code" class="form-label">Code</label>
            <input type="text" id="qc-code" class="form-control" maxlength="50" placeholder="Optional code" />
        </div>
    }

    @if (masterType == CatalogMasterType.Manufacturer)
    {
        <div class="mb-3">
            <label for="qc-license" class="form-label">License Number</label>
            <input type="text" id="qc-license" class="form-control" maxlength="80" placeholder="Optional" />
        </div>
    }

    @if (masterType == CatalogMasterType.GenericMedicine)
    {
        <div class="mb-3">
            <label for="qc-description" class="form-label">Description</label>
            <textarea id="qc-description" class="form-control" rows="3" placeholder="Optional description"></textarea>
        </div>
    }

    @if (masterType == CatalogMasterType.Strength)
    {
        <div class="row">
            <div class="col-md-6 mb-3">
                <label for="qc-value" class="form-label">Value</label>
                <input type="number" id="qc-value" class="form-control" step="0.0001" placeholder="e.g. 500" />
            </div>
            <div class="col-md-6 mb-3">
                <label for="qc-measurement-unit" class="form-label">Measurement Unit</label>
                <input type="text" id="qc-measurement-unit" class="form-control" maxlength="40" placeholder="e.g. mg, ml" />
            </div>
        </div>
    }

    @if (masterType == CatalogMasterType.Unit)
    {
        <div class="mb-3">
            <label for="qc-symbol" class="form-label">Symbol</label>
            <input type="text" id="qc-symbol" class="form-control" maxlength="20" placeholder="e.g. pcs, box" />
        </div>
        <div class="form-check mb-3">
            <input type="checkbox" id="qc-allows-decimal" class="form-check-input" />
            <label for="qc-allows-decimal" class="form-check-label">Allows Decimal</label>
        </div>
    }

    <div class="d-flex justify-content-end gap-2 mt-3">
        <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">
            <i class="ti ti-plus me-1"></i>Create @title
        </button>
    </div>
</form>
