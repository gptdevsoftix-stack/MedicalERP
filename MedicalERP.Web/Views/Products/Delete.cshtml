@model MedicalERP.Domain.DTOs.ProductDetailsDto

@{
    ViewData["Title"] = "Deactivate Product";
    var companyContextId = ViewBag.CompanyContextId as string;
}

<h2>Deactivate Product</h2>

<div class="alert alert-warning">
    Are you sure you want to deactivate
    <strong>@Model.Name</strong>?
</div>

<dl class="row">
    <dt class="col-sm-3">Code</dt>
    <dd class="col-sm-9">@Model.Code</dd>

    <dt class="col-sm-3">Category</dt>
    <dd class="col-sm-9">@Model.CategoryName</dd>
</dl>

<form asp-action="Delete"
      asp-route-id="@Model.Id"
      asp-route-companyContextId="@companyContextId"
      method="post">

    <input type="hidden" name="companyContextId" value="@companyContextId" />

    <button type="submit" class="btn btn-danger">
        Deactivate
    </button>

    <a asp-action="Index" asp-route-companyContextId="@companyContextId" class="btn btn-secondary">
        Cancel
    </a>
</form>
