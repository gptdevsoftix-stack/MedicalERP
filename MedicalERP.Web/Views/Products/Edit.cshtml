@model MedicalERP.Domain.DTOs.ProductFormDto

@{
    ViewData["Title"] = "Edit Product";
    var companyContextId = ViewBag.CompanyContextId as string;
}

<h2>Edit Product</h2>

<form asp-action="Edit"
      asp-route-id="@Model.Id"
      asp-route-companyContextId="@companyContextId"
      method="post">

    <input type="hidden" name="companyContextId" value="@companyContextId" />
    <input asp-for="Id" type="hidden" />

    <partial name="_ProductForm" model="Model" />

    <button type="submit" class="btn btn-primary">
        Update
    </button>

    <a asp-action="Index" asp-route-companyContextId="@companyContextId" class="btn btn-secondary">
        Cancel
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
