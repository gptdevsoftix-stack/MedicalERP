@model MedicalERP.Domain.DTOs.StoreProductFormDto

@{
    ViewData["Title"] = "Create Store Product";
    var companyContextId = ViewBag.CompanyContextId as string;
}

<h2>Create Store Product</h2>

<form asp-action="Create" method="post">
    <input type="hidden" name="companyContextId" value="@companyContextId" />
    @await Html.PartialAsync("_StoreProductForm", Model)
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index"
       asp-route-storeId="@Model.StoreId"
       asp-route-productId="@Model.ProductId"
       asp-route-companyContextId="@companyContextId"
       class="btn btn-secondary">
        Cancel
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
