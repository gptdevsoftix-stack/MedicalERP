@model MedicalERP.Domain.DTOs.StoreProductFormDto

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="StoreId" class="form-label"></label>
        <select asp-for="StoreId" asp-items="ViewBag.Stores" class="form-select">
            <option value="">Select store</option>
        </select>
        <span asp-validation-for="StoreId" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="ProductId" class="form-label"></label>
        <select asp-for="ProductId" asp-items="ViewBag.Products" class="form-select">
            <option value="">Select product</option>
        </select>
        <span asp-validation-for="ProductId" class="text-danger"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="SalePrice" class="form-label"></label>
        <input asp-for="SalePrice" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="SalePrice" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="WholesalePrice" class="form-label"></label>
        <input asp-for="WholesalePrice" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="WholesalePrice" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="MinimumSalePrice" class="form-label"></label>
        <input asp-for="MinimumSalePrice" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="MinimumSalePrice" class="text-danger"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="ReorderLevel" class="form-label"></label>
        <input asp-for="ReorderLevel" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="ReorderLevel" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="ReorderQuantity" class="form-label"></label>
        <input asp-for="ReorderQuantity" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="ReorderQuantity" class="text-danger"></span>
    </div>
</div>

<div class="form-check mb-3">
    <input asp-for="IsAvailableForSale" class="form-check-input" />
    <label asp-for="IsAvailableForSale" class="form-check-label"></label>
</div>
