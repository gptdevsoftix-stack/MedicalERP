@model IReadOnlyCollection<MedicalERP.Domain.DTOs.ProductUnitListDto>

@{
    ViewData["Title"] = "Product Units";
    var productId = ViewBag.ProductId as Guid?;
    var productName = ViewBag.ProductName as string ?? "Product";
    var companyContextId = ViewBag.CompanyContextId as string;
    var products = ViewBag.Products as IReadOnlyCollection<MedicalERP.Domain.DTOs.ProductListDto>;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">Product Units</h2>
        <div class="text-muted">@productName</div>
    </div>

    @if (productId.HasValue)
    {
        <a asp-action="Create"
           asp-route-productId="@productId"
           asp-route-companyContextId="@companyContextId"
           class="btn btn-primary">
            Add Unit
        </a>
    }
</div>

@if (TempData["SuccessMessage"] is not null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (TempData["ErrorMessage"] is not null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

@if (!productId.HasValue)
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Code</th>
                        <th>Category</th>
                        <th>Base Unit</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (products is null || products.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4">No products found.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var product in products)
                        {
                            <tr>
                                <td>@product.Name</td>
                                <td>@product.Code</td>
                                <td>@product.CategoryName</td>
                                <td>@product.BaseUnitName</td>
                                <td class="text-end">
                                    <a asp-action="Index"
                                       asp-route-productId="@product.Id"
                                       asp-route-companyContextId="@companyContextId"
                                       class="btn btn-sm btn-outline-primary">
                                        Units
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    return;
}

<div class="card">
    <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
            <thead>
                <tr>
                    <th>Unit</th>
                    <th>Symbol</th>
                    <th>Conversion Factor</th>
                    <th>Base</th>
                    <th>Purchase</th>
                    <th>Sale</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center py-4">No units assigned.</td>
                    </tr>
                }
                else
                {
                    @foreach (var unit in Model)
                    {
                        <tr>
                            <td>@unit.UnitName</td>
                            <td>@unit.UnitSymbol</td>
                            <td>@unit.ConversionFactor</td>
                            <td>@(unit.IsBaseUnit ? "Yes" : "No")</td>
                            <td>@(unit.IsPurchaseUnit ? "Yes" : "No")</td>
                            <td>@(unit.IsSaleUnit ? "Yes" : "No")</td>
                            <td>
                                <span class="badge bg-@(unit.IsActive ? "success" : "secondary")">
                                    @(unit.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit"
                                   asp-route-id="@unit.Id"
                                   asp-route-companyContextId="@companyContextId"
                                   class="btn btn-sm btn-outline-primary">
                                    Edit
                                </a>
                                @if (!unit.IsBaseUnit)
                                {
                                    <a asp-action="Delete"
                                       asp-route-id="@unit.Id"
                                       asp-route-companyContextId="@companyContextId"
                                       class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <a asp-controller="Products"
       asp-action="Details"
       asp-route-id="@productId"
       asp-route-companyContextId="@companyContextId"
       class="btn btn-secondary">
        Back to Product
    </a>
</div>
