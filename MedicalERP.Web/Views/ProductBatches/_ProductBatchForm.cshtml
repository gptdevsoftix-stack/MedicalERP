@model MedicalERP.Application.Inventory.Dtos.ProductBatchFormDto

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="ProductId" class="form-label"></label>
        <select asp-for="ProductId" asp-items="ViewBag.Products" class="form-select">
            <option value="">Select batch-tracked product</option>
        </select>
        <span asp-validation-for="ProductId" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="WarehouseId" class="form-label"></label>
        <select asp-for="WarehouseId" asp-items="ViewBag.Warehouses" class="form-select">
            <option value="">No warehouse assigned</option>
        </select>
        <span asp-validation-for="WarehouseId" class="text-danger"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="BatchNumber" class="form-label"></label>
        <input asp-for="BatchNumber" class="form-control" />
        <span asp-validation-for="BatchNumber" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="ManufacturingDate" class="form-label"></label>
        <input asp-for="ManufacturingDate" type="date" class="form-control" />
        <span asp-validation-for="ManufacturingDate" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="ExpiryDate" class="form-label"></label>
        <input asp-for="ExpiryDate" type="date" class="form-control" />
        <span asp-validation-for="ExpiryDate" class="text-danger"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-3 mb-3">
        <label asp-for="PurchasePrice" class="form-label"></label>
        <input asp-for="PurchasePrice" type="number" step="0.0001" class="form-control" />
        <span asp-validation-for="PurchasePrice" class="text-danger"></span>
    </div>
    <div class="col-md-3 mb-3">
        <label asp-for="CostPrice" class="form-label"></label>
        <input asp-for="CostPrice" type="number" step="0.0001" class="form-control" />
        <span asp-validation-for="CostPrice" class="text-danger"></span>
    </div>
    <div class="col-md-3 mb-3">
        <label asp-for="SalePrice" class="form-label"></label>
        <input asp-for="SalePrice" type="number" step="0.0001" class="form-control" />
        <span asp-validation-for="SalePrice" class="text-danger"></span>
    </div>
    <div class="col-md-3 mb-3">
        <label asp-for="MaximumRetailPrice" class="form-label"></label>
        <input asp-for="MaximumRetailPrice" type="number" step="0.0001" class="form-control" />
        <span asp-validation-for="MaximumRetailPrice" class="text-danger"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="ReceivedAt" class="form-label"></label>
        <input asp-for="ReceivedAt" type="datetime-local" class="form-control" />
        <span asp-validation-for="ReceivedAt" class="text-danger"></span>
    </div>
</div>
