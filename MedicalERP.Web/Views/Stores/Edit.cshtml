@model MedicalERP.Web.Models.StoreFormViewModel
@{ var isEdit = Model.Id.HasValue; ViewData["Title"] = isEdit ? "Edit Store" : "Create Store"; }
<div class="medical-page-title"><h1>@ViewData["Title"]</h1><p>Store relation: company context is selected explicitly for platform admins.</p></div>
<form method="post" class="card"><div class="card-body row g-3"><input asp-for="Id" type="hidden" />
@if (Model.Companies.Any()) { <div class="col-md-6"><label class="form-label">Company Context</label><select class="form-select" asp-for="CompanyContextId" asp-items="Model.Companies"><option value="">Select company</option></select></div> }
<div class="col-md-6"><label class="form-label" asp-for="Name"></label><input class="form-control" asp-for="Name" /></div><div class="col-md-6"><label class="form-label" asp-for="Code"></label><input class="form-control" asp-for="Code" readonly="@(isEdit)" /></div>
<div class="col-md-6"><label class="form-label" asp-for="Email"></label><input class="form-control" asp-for="Email" /></div><div class="col-md-6"><label class="form-label" asp-for="Phone"></label><input class="form-control" asp-for="Phone" /></div>
<div class="col-12"><label class="form-label" asp-for="Address"></label><input class="form-control" asp-for="Address" /></div><div class="col-md-4"><label class="form-label" asp-for="City"></label><input class="form-control" asp-for="City" /></div><div class="col-md-4"><label class="form-label" asp-for="State"></label><input class="form-control" asp-for="State" /></div><div class="col-md-4"><label class="form-label" asp-for="Country"></label><input class="form-control" asp-for="Country" /></div>
<div class="col-md-4"><label class="form-label" asp-for="TaxNumber"></label><input class="form-control" asp-for="TaxNumber" /></div><div class="col-md-4"><label class="form-label" asp-for="CurrencyCode"></label><input class="form-control" asp-for="CurrencyCode" /></div><div class="col-md-4"><label class="form-label" asp-for="TimeZone"></label><input class="form-control" asp-for="TimeZone" /></div>
<div class="col-12"><div class="form-check"><input class="form-check-input" asp-for="IsHeadOffice" /><label class="form-check-label" asp-for="IsHeadOffice"></label></div></div>@if(isEdit){<div class="col-12"><div class="form-check"><input class="form-check-input" asp-for="IsActive" /><label class="form-check-label" asp-for="IsActive"></label></div></div>}
<div class="col-12 d-flex gap-2"><button class="btn btn-primary">Save</button><a class="btn btn-label-secondary" asp-action="Index">Cancel</a></div></div></form>
