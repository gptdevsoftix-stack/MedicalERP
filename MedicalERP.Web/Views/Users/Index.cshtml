@model MedicalERP.Application.Common.PagedResult<MedicalERP.Application.Identity.Dtos.UserDto>
@{ ViewData["Title"] = "Users"; }
<div class="medical-page-title d-flex justify-content-between align-items-center"><div><h1>Users</h1><p>Employees, roles, and store access.</p></div><a class="btn btn-primary" asp-action="CreatePage"><i class="ti ti-plus me-1"></i>Create</a></div>
<div class="card"><div class="table-responsive"><table class="table"><thead><tr><th>Email</th><th>Name</th><th>Roles</th><th>Stores</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td>@item.Email</td><td>@item.FirstName @item.LastName</td><td>@string.Join(", ", item.Roles)</td><td>@item.StoreIds.Count</td><td>@(item.IsActive ? "Active" : "Inactive")</td><td class="text-end"><a class="btn btn-sm btn-label-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a><form class="d-inline" asp-action="Delete" asp-route-id="@item.Id" method="post"><button class="btn btn-sm btn-label-danger">Delete</button></form></td></tr>}</tbody></table></div></div>
