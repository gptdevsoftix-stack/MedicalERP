@model MedicalERP.Web.Models.UserFormViewModel
@{ var isEdit = Model.Id.HasValue; ViewData["Title"] = isEdit ? "Edit User" : "Create User"; }
<div class="medical-page-title"><h1>@ViewData["Title"]</h1><p>User role and store relationships.</p></div>
<form method="post" class="card"><div class="card-body row g-3"><input asp-for="Id" type="hidden" />
@if (Model.Companies.Any()) { <div class="col-md-6"><label class="form-label">Company Context</label><select class="form-select" asp-for="CompanyContextId" asp-items="Model.Companies"><option value="">Select company</option></select></div> }
<div class="col-md-6"><label class="form-label" asp-for="Email"></label><input class="form-control" asp-for="Email" readonly="@(isEdit)" /></div>
@if(!isEdit){<div class="col-md-6"><label class="form-label" asp-for="Password"></label><input class="form-control" asp-for="Password" type="password" /></div>}
<div class="col-md-6"><label class="form-label" asp-for="FirstName"></label><input class="form-control" asp-for="FirstName" /></div><div class="col-md-6"><label class="form-label" asp-for="LastName"></label><input class="form-control" asp-for="LastName" /></div>
<div class="col-md-6"><label class="form-label">Roles</label><select class="form-select" asp-for="SelectedRoles" asp-items="Model.Roles" multiple size="8"></select></div>
<div class="col-md-6"><label class="form-label">Stores</label><select class="form-select" asp-for="SelectedStoreIds" asp-items="Model.Stores" multiple size="8"></select></div>
@if(isEdit){<div class="col-12"><div class="form-check"><input class="form-check-input" asp-for="IsActive" /><label class="form-check-label" asp-for="IsActive"></label></div></div>}
<div class="col-12 d-flex gap-2"><button class="btn btn-primary">Save</button><a class="btn btn-label-secondary" asp-action="Index">Cancel</a></div></div></form>
