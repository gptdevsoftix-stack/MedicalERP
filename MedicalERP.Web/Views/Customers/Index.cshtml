@model PagedResult<MedicalERP.Application.Sales.Dtos.CustomerListDto>
@{ ViewData["Title"] = "Customers"; var search = ViewBag.Search as string; var isActive = ViewBag.IsActive as bool?; var companyContextId = ViewBag.CompanyContextId as string; }
<div class="d-flex justify-content-between align-items-center mb-3"><div><h2 class="mb-1">Customers</h2><div class="text-muted">Customers for the current company.</div></div><a asp-action="Create" class="btn btn-primary"><i class="ti ti-plus me-1"></i>New Customer</a></div>
@if (TempData["SuccessMessage"] is not null) { <div class="alert alert-success">@TempData["SuccessMessage"]</div> }
<form method="get" class="card card-body mb-3"><input type="hidden" name="companyContextId" value="@companyContextId" /><div class="row g-2 align-items-end"><div class="col-md-6"><label class="form-label">Search</label><input name="search" value="@search" class="form-control" placeholder="Name, code, contact, phone" /></div><div class="col-md-3"><label class="form-label">Status</label><select name="isActive" class="form-select"><option value="">All</option><option value="true" selected="@(isActive == true)">Active</option><option value="false" selected="@(isActive == false)">Inactive</option></select></div><div class="col-md-3 d-flex gap-2"><button class="btn btn-outline-primary">Filter</button><a asp-action="Index" class="btn btn-outline-secondary">Clear</a></div></div></form>
<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Name</th><th>Code</th><th>Contact</th><th>Credit</th><th>Status</th><th class="text-end">Actions</th></tr></thead><tbody>@if (Model.Items.Count == 0) { <tr><td colspan="6" class="text-center py-4">No customers found.</td></tr> } @foreach (var item in Model.Items) { <tr><td><div class="fw-semibold">@item.Name</div><small class="text-muted">@item.Email</small></td><td>@item.Code</td><td>@item.Phone<br /><small class="text-muted">@item.Email</small></td><td>@item.CreditDays days<br /><small class="text-muted">Limit: @item.CreditLimit.ToString("N2")</small></td><td><span class="badge bg-@(item.IsActive ? "success" : "secondary")">@(item.IsActive ? "Active" : "Inactive")</span></td><td class="text-end"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>@if (item.IsActive) { <form asp-action="Deactivate" asp-route-id="@item.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-danger">Deactivate</button></form> }</td></tr> }</tbody></table></div></div>
@await Html.PartialAsync("_Pagination", Model)
