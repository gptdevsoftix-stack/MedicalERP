@model MedicalERP.Domain.DTOs.CatalogMasterDto

@{
    ViewData["Title"] = $"Deactivate {ViewBag.SingularTitle}";
    var companyContextId = ViewBag.CompanyContextId as string;
}

<h2>Deactivate @ViewBag.SingularTitle</h2>

<div class="alert alert-warning">
    Are you sure you want to deactivate <strong>@Model.Name</strong>?
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <input type="hidden" name="companyContextId" value="@companyContextId" />
    <button type="submit" class="btn btn-danger">Deactivate</button>
    <a asp-action="Index" asp-route-companyContextId="@companyContextId" class="btn btn-secondary">Cancel</a>
</form>
