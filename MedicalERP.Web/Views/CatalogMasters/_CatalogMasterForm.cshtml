@model MedicalERP.Domain.DTOs.CatalogMasterFormDto
@using MedicalERP.Domain.Enums

@{
    var masterType = (CatalogMasterType)ViewBag.MasterType;
}

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>

@if (masterType is CatalogMasterType.ProductBrand or CatalogMasterType.Manufacturer or CatalogMasterType.DosageForm)
{
    <div class="mb-3">
        <label asp-for="Code" class="form-label"></label>
        <input asp-for="Code" class="form-control" />
        <span asp-validation-for="Code" class="text-danger"></span>
    </div>
}

@if (masterType == CatalogMasterType.Manufacturer)
{
    <div class="mb-3">
        <label asp-for="LicenseNumber" class="form-label"></label>
        <input asp-for="LicenseNumber" class="form-control" />
        <span asp-validation-for="LicenseNumber" class="text-danger"></span>
    </div>
}

@if (masterType == CatalogMasterType.GenericMedicine)
{
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
}

@if (masterType == CatalogMasterType.Strength)
{
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Value" class="form-label"></label>
            <input asp-for="Value" type="number" step="0.0001" class="form-control" />
            <span asp-validation-for="Value" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="MeasurementUnit" class="form-label"></label>
            <input asp-for="MeasurementUnit" class="form-control" />
            <span asp-validation-for="MeasurementUnit" class="text-danger"></span>
        </div>
    </div>
}

@if (masterType == CatalogMasterType.Unit)
{
    <div class="mb-3">
        <label asp-for="Symbol" class="form-label"></label>
        <input asp-for="Symbol" class="form-control" />
        <span asp-validation-for="Symbol" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input asp-for="AllowsDecimal" class="form-check-input" />
        <label asp-for="AllowsDecimal" class="form-check-label"></label>
    </div>
}
